---
import Layout from '../../../layouts/Layout.astro';
import CodeBlock from '../../../components/CodeBlock.astro';

export function getStaticPaths() {
  return ['postgresql', 'sqlite', 'python', 'wasm'].map(slug => ({ params: { slug } }));
}

interface Section {
  heading: string;
  body?: string;
  tabs?: { label: string; lang: string; code: string }[];
  code?: string;
  lang?: string;
  label?: string;
}

interface IntegrationData {
  title: string;
  icon: string;
  description: string;
  sections: Section[];
}

const integrations: Record<string, IntegrationData> = {
  postgresql: {
    title: 'PostgreSQL FTS',
    icon: '🐘',
    description: 'kham-pg เป็น extension ค้นหาข้อความแบบ Full-Text สำหรับ PostgreSQL แต่ละ token ภาษาไทยขยายเป็น lexeme สูงสุด 6 ตัวในตำแหน่งเดียวกัน: คำเอง, รหัส soundex lk82, RTGS, รูป ASCII (สำหรับเลขไทย) และ tag ชนิดคำ (POS) คำ stopword จะถูกกรองออกอัตโนมัติ',
    sections: [
      {
        heading: 'สิ่งที่ต้องมีก่อน',
        body: 'PostgreSQL 14 ขึ้นไป, Rust toolchain (1.85+) และ pg_config ใน PATH',
        code: 'pg_config --version   # PostgreSQL 14 หรือใหม่กว่า',
        lang: 'bash', label: 'shell',
      },
      {
        heading: 'Build และติดตั้ง',
        code: `cargo build -p kham-pg --release
make -C kham-pg install`,
        lang: 'bash', label: 'shell',
      },
      {
        heading: 'Load และใช้งาน',
        body: 'extension มี configuration kham พร้อมใช้ทันที คำ stopword ภาษาไทยถูกกรองออกอัตโนมัติโดยไม่ต้องตั้งค่าเพิ่ม',
        code: `-- โหลด extension
CREATE EXTENSION kham_pg;

-- ค้นหาข้อความแบบ full-text ด้วย configuration kham ในตัว
SELECT to_tsvector('kham', 'กินข้าวกับปลา') @@ plainto_tsquery('kham', 'ปลา');
-- t  (กับ เป็น stopword จึงถูกกรองออก; ปลา ถูก index ไว้)`,
        lang: 'sql', label: 'psql',
      },
      {
        heading: 'Index เอกสาร',
        code: `CREATE TABLE articles (
  id    SERIAL PRIMARY KEY,
  title TEXT,
  body  TEXT,
  tsv   TSVECTOR
);

UPDATE articles
SET tsv = to_tsvector('kham', coalesce(title, '') || ' ' || coalesce(body, ''));

CREATE INDEX articles_tsv_idx ON articles USING GIN(tsv);

CREATE TRIGGER articles_tsv_update
  BEFORE INSERT OR UPDATE ON articles
  FOR EACH ROW EXECUTE FUNCTION
    tsvector_update_trigger(tsv, 'public.kham', title, body);`,
        lang: 'sql', label: 'psql',
      },
      {
        heading: 'ค้นหาด้วย ts_headline',
        code: `SELECT id,
  ts_headline('kham', body, query,
    'StartSel=<mark>, StopSel=</mark>') AS snippet
FROM articles,
     to_tsquery('kham', 'ข้าว & ปลา') AS query
WHERE tsv @@ query
ORDER BY ts_rank(tsv, query) DESC;`,
        lang: 'sql', label: 'psql',
      },
      {
        heading: 'ค้นหาแบบ phonetic และ romanization',
        body: 'token ภาษาไทยทุกตัวจะขยายด้วยรหัส soundex lk82 และ RTGS romanization — คำพ้องเสียงและ query ภาษาอังกฤษจึงเจอเอกสารภาษาไทยได้ทันที',
        code: `-- query ภาษาอังกฤษ (RTGS) ค้นหาเอกสารภาษาไทย
SELECT to_tsvector('kham', 'กินข้าวกับปลา') @@ plainto_tsquery('kham', 'pla');
-- t  (ปลา → 'pla' ถูก index ไว้ในตำแหน่งเดียวกัน)

-- ค้นหาด้วยรหัส lk82 ของ ปลา (4800)
SELECT title FROM articles WHERE tsv @@ to_tsquery('kham', '4800');`,
        lang: 'sql', label: 'psql',
      },
      {
        heading: 'การแปลงตัวเลขไทย',
        body: 'ตัวเลขไทย (๑๒๓) ถูก index พร้อมกับรูป ASCII (123) ในตำแหน่งเดียวกัน',
        code: `-- ค้นหา ๑๒๓ ด้วยตัวเลข ASCII
SELECT to_tsvector('kham', '๑๒๓') @@ plainto_tsquery('kham', '123') AS found;
-- t`,
        lang: 'sql', label: 'psql',
      },
      {
        heading: 'การกรองด้วย POS lexeme',
        body: 'token ที่รู้ชนิดคำจะมี pos_<tag> เป็น lexeme เพิ่ม ใช้ ::tsquery cast เพื่อให้ underscore ไม่ถูกตัดแยก',
        code: `-- หาเอกสารที่มีคำกริยา
SELECT title FROM articles WHERE tsv @@ 'pos_verb'::tsquery;

-- ดู POS tags ที่ถูก index สำหรับคำนั้น
SELECT lexeme FROM unnest(to_tsvector('kham', 'ปลา'))
WHERE lexeme LIKE 'pos_%';
-- pos_noun`,
        lang: 'sql', label: 'psql',
      },
      {
        heading: 'Dictionary soundex variants',
        body: 'มี dictionary variants สองแบบสำหรับการจับเสียงที่ละเอียดกว่า',
        code: `-- udom83 soundex
CREATE TEXT SEARCH CONFIGURATION kham_udom83 (PARSER = kham);
ALTER TEXT SEARCH CONFIGURATION kham_udom83
    ADD MAPPING FOR thai, named WITH kham_fts_dict_udom83;
ALTER TEXT SEARCH CONFIGURATION kham_udom83
    ADD MAPPING FOR latin, number, unknown WITH kham_dict;

-- MetaSound
CREATE TEXT SEARCH CONFIGURATION kham_metasound (PARSER = kham);
ALTER TEXT SEARCH CONFIGURATION kham_metasound
    ADD MAPPING FOR thai, named WITH kham_fts_dict_metasound;
ALTER TEXT SEARCH CONFIGURATION kham_metasound
    ADD MAPPING FOR latin, number, unknown WITH kham_dict;`,
        lang: 'sql', label: 'psql',
      },
      {
        heading: 'การจัดอันดับและ field boosting',
        body: 'ใช้ ts_rank() หรือ ts_rank_cd() เรียงผลตามความเกี่ยวข้อง และใช้ setweight() เพิ่มน้ำหนักแต่ละ field — น้ำหนัก A (1.0) > B (0.4) > C (0.2) > D (0.1)',
        code: `-- จัดอันดับพื้นฐาน
SELECT id, ts_rank(tsv, query) AS rank
FROM articles, to_tsquery('kham', 'ข้าว') query
WHERE tsv @@ query
ORDER BY rank DESC;

-- Field boosting: token น้ำหนัก A มีค่า ~5× เทียบกับน้ำหนัก C
UPDATE articles
SET tsv =
  setweight(to_tsvector('kham', coalesce(title, '')), 'A') ||
  setweight(to_tsvector('kham', coalesce(body,  '')), 'C');`,
        lang: 'sql', label: 'psql',
      },
    ],
  },

  sqlite: {
    title: 'SQLite FTS5',
    icon: '🗃️',
    description: 'kham-sqlite เป็น loadable extension สำหรับ SQLite ที่ให้ custom FTS5 tokenizer ช่วยตัดคำภาษาไทยในการทำ FTS5 MATCH query ให้ถูกต้อง',
    sections: [
      {
        heading: 'สิ่งที่ต้องมีก่อน',
        body: 'SQLite ที่เปิดใช้งาน FTS5 และรองรับ load_extension บน macOS ต้องติดตั้งจาก Homebrew เพราะ system sqlite3 ปิด load_extension',
        tabs: [
          { label: 'macOS', lang: 'bash', code: 'brew install sqlite' },
          { label: 'Ubuntu/Debian', lang: 'bash', code: 'sudo apt install libsqlite3-dev sqlite3' },
        ],
      },
      {
        heading: 'Build extension',
        code: `cargo build -p kham-sqlite --release
# ไฟล์อยู่ที่:
#   Linux:  target/release/libkham_sqlite.so
#   macOS:  target/release/libkham_sqlite.dylib`,
        lang: 'bash', label: 'shell',
      },
      {
        heading: 'Load และสร้างตาราง FTS5',
        code: `.load ./target/release/libkham_sqlite

CREATE VIRTUAL TABLE docs USING fts5(
  title, body,
  tokenize = 'kham'
);`,
        lang: 'sql', label: 'sqlite3',
      },
      {
        heading: 'Insert และค้นหา',
        code: `INSERT INTO docs VALUES
  ('อาหารไทย', 'กินข้าวกับปลาและผัก'),
  ('เมืองหลวง', 'กรุงเทพมหานครเป็นเมืองหลวงของประเทศไทย');

SELECT * FROM docs WHERE docs MATCH 'ปลา';
SELECT snippet(docs, 1, '<b>', '</b>', '…', 10)
FROM docs WHERE docs MATCH 'กรุงเทพ';`,
        lang: 'sql', label: 'sqlite3',
      },
      {
        heading: 'argument ของ tokenize',
        body: 'ทุก argument เป็น optional และไม่ขึ้นกับลำดับ path ของไฟล์ต้องใส่ single quote ภายใน tokenize directive (FTS5 bareword รองรับเฉพาะ A–Z, 0–9 และ _) และ escape สำหรับ SQL ด้วย \'\' (single quote สองตัว)',
        code: `-- lk82 soundex (default) — คำที่ออกเสียงใกล้เคียงจะมีรหัสเดียวกัน
CREATE VIRTUAL TABLE t1 USING fts5(body, tokenize='kham');

-- udom83 soundex (แยกแยะ sibilant/liquid ละเอียดกว่า)
CREATE VIRTUAL TABLE t2 USING fts5(body, tokenize='kham soundex udom83');

-- ปิด soundex
CREATE VIRTUAL TABLE t3 USING fts5(body, tokenize='kham soundex none');

-- ไม่ index stopword
CREATE VIRTUAL TABLE t4 USING fts5(body, tokenize='kham stopwords on');

-- bigram สำหรับ OOV/unknown token (default: trigram; 0 = ปิด)
CREATE VIRTUAL TABLE t5 USING fts5(body, tokenize='kham ngram_size 2');

-- custom synonym map (path ต้องใส่ single quote)
CREATE VIRTUAL TABLE t6 USING fts5(body,
  tokenize='kham synonyms ''/etc/kham/synonyms.tsv''');

-- custom word list (overlay บน built-in dictionary ไม่ rebuild trie)
CREATE VIRTUAL TABLE t7 USING fts5(body,
  tokenize='kham dict ''/etc/kham/domain_words.txt''');

-- รวมทุก option
CREATE VIRTUAL TABLE t8 USING fts5(body,
  tokenize='kham soundex lk82 stopwords on ngram_size 2
            dict ''/words.txt'' synonyms ''/syns.tsv''');`,
        lang: 'sql', label: 'sqlite3',
      },
      {
        heading: 'การจัดอันดับและ field boosting',
        body: 'FTS5 มี BM25 built-in ค่าต่ำกว่า (ติดลบมากกว่า) = match ดีกว่า ส่งน้ำหนัก column เพื่อให้ title มีผลมากกว่า body การ match แบบ phonetic/soundex ได้น้ำหนัก BM25 เท่ากับ exact match — หากต้องการลด ให้ rerank ใน application code',
        code: `-- BM25 พื้นฐาน (ค่าน้อยกว่า = match ดีกว่า)
SELECT title, body, bm25(docs) AS score
FROM docs
WHERE docs MATCH 'ปลา'
ORDER BY score;

-- Field boosting: title 10×, body 1×
-- argument ตามลำดับ column ใน CREATE VIRTUAL TABLE
CREATE VIRTUAL TABLE docs USING fts5(title, body, tokenize='kham');

SELECT title, bm25(docs, 10.0, 1.0) AS score
FROM docs
WHERE docs MATCH 'ปลา'
ORDER BY score;

-- Exact match vs phonetic match: FTS5 ให้น้ำหนักเท่ากัน
-- หากต้องการแยก:
--   1. ดึง candidate ด้วย FTS5 MATCH (ใช้ index เร็ว)
--   2. ใน app code ตรวจ query term ว่า exact token หรือไม่ (edit distance 0)
--   3. คูณ BM25 score × 0.3 สำหรับ phonetic-only match`,
        lang: 'sql', label: 'sqlite3',
      },
    ],
  },

  python: {
    title: 'Python',
    icon: '🐍',
    description: 'Python bindings ของ kham สร้างด้วย PyO3 เปิดให้ใช้งาน API ตัดคำแบบเต็มรูปแบบ รวมถึง Token object พร้อม kind, POS, NE และข้อมูล span',
    sections: [
      {
        heading: 'ติดตั้ง',
        tabs: [
          { label: 'pip', lang: 'bash', code: 'pip install kham' },
          { label: 'uv', lang: 'bash', code: 'uv add kham' },
          { label: 'poetry', lang: 'bash', code: 'poetry add kham' },
        ],
      },
      {
        heading: 'ตัดคำพื้นฐาน',
        code: `import kham

words = kham.segment("กินข้าวกับปลา")
print(words)
# ['กิน', 'ข้าว', 'กับ', 'ปลา']

mixed = kham.segment("Hello กรุงเทพ 2024!")
print(mixed)`,
        lang: 'python', label: 'example.py',
      },
      {
        heading: 'Token object แบบ rich',
        code: `import kham

tokens = kham.segment_tokens("กินข้าวกับปลา")
for tok in tokens:
    print(f"{tok.text!r:10}  kind={tok.kind:12}  chars={tok.char_start}..{tok.char_end}")`,
        lang: 'python', label: 'example.py',
      },
      {
        heading: 'Field ของ Token',
        code: `tok.text        # str  — ข้อความ token
tok.kind        # str  — "Thai" | "Latin" | "Number" | "Punctuation" | ...
tok.char_start  # int  — จุดเริ่มต้น Unicode (ใช้กับ str.slice())
tok.char_end    # int  — จุดสิ้นสุด Unicode
tok.byte_start  # int  — byte offset UTF-8 เริ่มต้น
tok.byte_end    # int  — byte offset UTF-8 สิ้นสุด`,
        lang: 'python', label: 'reference',
      },
      {
        heading: 'ตรวจสอบคำสะกด',
        body: 'spell_suggestions() ค้นหาคำใน dictionary ที่มี edit distance ≤ 2 จัดอันดับด้วย lk82 phonetic และ TNC frequency รับคำเดียว — หากมีหลายคำให้ segment ก่อน',
        code: `import kham

# spell_suggestions(word, max_n) → list[SpellSuggestion]
suggs = kham.spell_suggestions("กีนข้าว", 5)
for s in suggs:
    print(f"{s.word:12} edit={s.edit_distance} soundex={s.soundex_match} freq={s.freq_score}")
# กินข้าว  edit=1  soundex=True  freq=…

# SpellSuggestion: .word  .edit_distance  .soundex_match  .freq_score`,
        lang: 'python', label: 'spell.py',
      },
      {
        heading: 'สกัดคำสำคัญ',
        body: 'extract_keywords() คืนคำที่โดดเด่นที่สุดในเอกสาร คำนวณด้วย TF × inverse-corpus-frequency ตัด stopword ออกโดยอัตโนมัติ',
        code: `import kham

text = ("นักวิทยาศาสตร์ค้นพบดาวเคราะห์ใหม่ในระบบสุริยะ "
        "ดาวดวงนี้โคจรอยู่ใกล้ดาวเคราะห์น้อย")

keywords = kham.extract_keywords(text, 5)
for kw in keywords:
    print(f"{kw.word:12} score={kw.score:.4f} count={kw.count}")

# Keyword: .word  .score  .count`,
        lang: 'python', label: 'keywords.py',
      },
    ],
  },

  wasm: {
    title: 'WebAssembly / npm',
    icon: '🌐',
    description: 'kham-wasm นำการตัดคำภาษาไทยมาสู่เบราว์เซอร์และ Node.js โดยไม่ต้องใช้เซิร์ฟเวอร์ ไฟล์ WASM ขนาดประมาณ 300 KB และมี dictionary ในตัว',
    sections: [
      {
        heading: 'ติดตั้ง',
        code: 'npm install kham-wasm',
        lang: 'bash', label: 'shell',
      },
      {
        heading: 'Browser — ES module',
        body: 'import init และเรียกครั้งเดียวเพื่อโหลดไฟล์ .wasm จากนั้นใช้ segment() หรือ segment_tokens() ได้เลย',
        code: `import init, { segment, segment_tokens } from 'kham-wasm';

await init(); // โหลด WebAssembly module

const words = segment("กินข้าวกับปลา");
console.log(words);
// ["กิน", "ข้าว", "กับ", "ปลา"]`,
        lang: 'typescript', label: 'browser.ts',
      },
      {
        heading: 'Lazy loading (แนะนำ)',
        body: 'โหลด WASM ในพื้นหลังเพื่อไม่ให้บล็อคการแสดงผลหน้าเว็บ',
        code: `let kham: any = null;

async function getKham() {
  if (kham) return kham;
  const mod = await import('kham-wasm');
  await mod.default();
  kham = mod;
  return kham;
}

// โหลดล่วงหน้าในพื้นหลัง
getKham().catch(console.error);`,
        lang: 'typescript', label: 'lazy.ts',
      },
      {
        heading: 'ตรวจสอบคำสะกด',
        body: 'spell_suggestions(word, maxN) ค้นหา candidate ใน dictionary ที่มี edit distance ≤ 2 จัดอันดับด้วย lk82 phonetic similarity และ TNC corpus frequency',
        code: `import init, { spell_suggestions } from 'kham-wasm';
await init();

// spell_suggestions(word, maxN) → SpellSuggestion[]
const suggs = spell_suggestions("กีนข้าว", 5);
for (const s of suggs) {
  console.log(s.word, 'edit:', s.edit_distance,
              'soundex:', s.soundex_match, 'freq:', s.freq_score);
}
// กินข้าว  edit: 1  soundex: true  freq: …

// SpellSuggestion: .word  .edit_distance  .soundex_match  .freq_score`,
        lang: 'typescript', label: 'spell.ts',
      },
      {
        heading: 'สกัดคำสำคัญ',
        body: 'extract_keywords(text, maxN) คืนคำที่โดดเด่นที่สุด คะแนน TF × inverse-corpus-frequency ตัด stopword ออกโดยอัตโนมัติ',
        code: `import init, { extract_keywords } from 'kham-wasm';
await init();

// extract_keywords(text, maxN) → Keyword[]
const text = "นักวิทยาศาสตร์ค้นพบดาวเคราะห์ใหม่ในระบบสุริยะ " +
             "ดาวดวงนี้โคจรอยู่ใกล้ดาวเคราะห์น้อย";

const keywords = extract_keywords(text, 5);
for (const kw of keywords) {
  console.log(kw.word, 'score:', kw.score.toFixed(4), 'count:', kw.count);
}

// Keyword: .word  .score  .count`,
        lang: 'typescript', label: 'keywords.ts',
      },
    ],
  },
};

const { slug } = Astro.params;
const data = integrations[slug as keyof typeof integrations];
---

<Layout title={`${data.title} — คู่มือการใช้งาน kham`} description={data.description} lang="th">
  <div class="max-w-4xl mx-auto px-6 py-16">
    <nav class="text-sm text-slate-500 dark:text-slate-400 mb-8">
      <a href="/th/getting-started" class="hover:text-slate-800 dark:hover:text-slate-200 transition-colors">เริ่มต้นใช้งาน</a>
      <span class="mx-2">/</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium">{data.title}</span>
    </nav>

    <div class="mb-12">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-4xl">{data.icon}</span>
        <h1 class="text-4xl font-bold text-slate-900 dark:text-slate-100">{data.title}</h1>
      </div>
      <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl">{data.description}</p>
    </div>

    <div class="space-y-14">
      {data.sections.map((section, i) => (
        <section>
          <div class="flex items-center gap-3 mb-3">
            <span class="flex-none w-7 h-7 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400 text-xs font-bold flex items-center justify-center">{i + 1}</span>
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100">{section.heading}</h2>
          </div>
          {section.body && <p class="text-slate-600 dark:text-slate-400 mb-4 ml-10">{section.body}</p>}
          <div class="ml-10">
            {section.tabs
              ? <CodeBlock tabs={section.tabs} />
              : <CodeBlock code={section.code} lang={section.lang} label={section.label} />
            }
          </div>
        </section>
      ))}
    </div>

    <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-700 flex justify-between text-sm">
      <a href="/th/getting-started" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium transition-colors">← เริ่มต้นใช้งาน</a>
      <a href="/th/demo" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium transition-colors">ทดลองใช้งาน →</a>
    </div>
  </div>
</Layout>
