---
// Examples are defined in the script block as JS Unicode escapes so the
// HTML parser cannot silently normalize the codepoints before JS reads them.
---

<div class="normalizer-root font-sans">
  <!-- Header -->
  <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
    <div>
      <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Text Normalizer</h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
        Collapses duplicate tone marks and composes nikhahit&nbsp;+&nbsp;sara aa into sara am (อำ).
      </p>
    </div>
    <!-- Unicode toggle -->
    <button
      id="norm-unicode-toggle"
      type="button"
      aria-pressed="false"
      class="text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-500 dark:text-slate-400 hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
    >
      U+ codes
    </button>
  </div>

  <!-- Input + quick examples -->
  <div class="mb-5">
    <label for="norm-input" class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5">Input</label>
    <textarea
      id="norm-input"
      rows="2"
      placeholder="พิมพ์ข้อความภาษาไทย…"
      aria-label="Text to normalize"
      class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3 py-2 text-base font-sans focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none placeholder:text-slate-400"
    ></textarea>

    <div class="flex flex-wrap items-center gap-2 mt-2">
      <span class="text-xs text-slate-500 dark:text-slate-400">Try:</span>
      <!-- Examples injected by script to preserve exact codepoints -->
      <span id="norm-examples"></span>
    </div>
  </div>

  <!-- Before / After panels -->
  <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr] items-start gap-3">

    <!-- Before -->
    <div>
      <span class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide">Before</span>
      <div
        id="norm-before"
        class="mt-1.5 min-h-[64px] rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 px-4 py-3 text-base leading-relaxed break-all text-slate-400 dark:text-slate-500 italic"
      >
        <span class="select-none">—</span>
      </div>
    </div>

    <!-- Arrow -->
    <div class="hidden sm:flex items-center justify-center pt-8">
      <svg class="w-5 h-5 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </div>

    <!-- After -->
    <div>
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide">After</span>
        <span id="norm-status" class="text-xs font-medium text-slate-400 dark:text-slate-500"></span>
      </div>
      <div
        id="norm-after"
        aria-live="polite"
        class="mt-1.5 min-h-[64px] rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 px-4 py-3 text-base leading-relaxed break-all text-slate-400 dark:text-slate-500 italic"
      >
        <span class="select-none">—</span>
      </div>
    </div>
  </div>

  <!-- Legend -->
  <div id="norm-legend" class="hidden mt-3 flex flex-wrap items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
    <span class="flex items-center gap-1.5">
      <span class="inline-block w-3 h-3 rounded-sm bg-red-100 dark:bg-red-900/40 border border-red-300 dark:border-red-700"></span>
      removed / collapsed
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block w-3 h-3 rounded-sm bg-emerald-100 dark:bg-emerald-900/40 border border-emerald-300 dark:border-emerald-700"></span>
      composed
    </span>
  </div>
</div>

<script is:inline>
(function () {
  let wasmMod     = null;
  let showUnicode = false;
  let lastInput   = '';
  let lastOutput  = '';

  // ---------------------------------------------------------------------------
  // Examples — defined here as JS strings so codepoints survive HTML parsing
  // ---------------------------------------------------------------------------
  const EXAMPLES = [
    {
      label: 'Duplicate tone',
      // ข (0E02) + mai tho (0E49) + mai tho (0E49) + า (0E32) + ว (0E27)
      raw: 'ข้้าว',
    },
    {
      label: 'Sara Am compose',
      // ก (0E01) + nikhahit (0E4D) + sara aa (0E32) + ก (0E01) + sara i (0E31) + บ (0E1A)
      raw: 'กํากับ',
    },
    {
      label: 'Already clean',
      raw: 'กินข้าวกับปลา',
    },
  ];

  // ---------------------------------------------------------------------------
  // WASM
  // ---------------------------------------------------------------------------
  async function loadWasm() {
    if (wasmMod) return wasmMod;
    const mod = await import('/wasm/kham_wasm.js');
    await mod.default();
    wasmMod = mod;
    return wasmMod;
  }

  // ---------------------------------------------------------------------------
  // Unicode helpers
  // ---------------------------------------------------------------------------
  const TONE_MARKS = new Set([0x0E48, 0x0E49, 0x0E4A, 0x0E4B]);
  const NIKHAHIT   = 0x0E4D;
  const SARA_AA    = 0x0E32;
  const SARA_AM    = 0x0E33;

  function esc(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function cpLabel(ch) {
    return 'U+' + ch.codePointAt(0).toString(16).toUpperCase().padStart(4, '0');
  }

  // Wrap a single character in an optional unicode annotation cell.
  // colorClass: Tailwind classes for bg/text, e.g. '' | 'bg-red-100 ...' | 'bg-emerald-100 ...'
  function charCell(ch, colorClass, strikethrough, title) {
    const cp = cpLabel(ch);
    const titleAttr = title ? ` title="${esc(title)}"` : '';
    if (!showUnicode) {
      if (!colorClass) return esc(ch);
      const strike = strikethrough ? ' line-through' : '';
      return `<span class="rounded px-0.5 ${colorClass}${strike}"${titleAttr}>${esc(ch)}</span>`;
    }
    // Unicode mode: stack glyph + codepoint vertically in an inline-block cell
    const strike = strikethrough ? ' line-through' : '';
    const bg = colorClass ? ` ${colorClass}` : '';
    return `<span class="inline-flex flex-col items-center mx-0.5 rounded${bg}${strike} px-0.5 align-bottom"${titleAttr}>` +
           `<span class="text-base leading-none">${esc(ch)}</span>` +
           `<span class="text-[9px] font-mono leading-none mt-0.5 opacity-60">${cp}</span>` +
           `</span>`;
  }

  // ---------------------------------------------------------------------------
  // Diff builders
  // ---------------------------------------------------------------------------

  function buildBeforeHtml(input, output) {
    if (input === output) {
      if (!showUnicode) return `<span class="text-slate-800 dark:text-slate-100 not-italic">${esc(input)}</span>`;
      return `<span class="text-slate-800 dark:text-slate-100 not-italic inline-flex flex-wrap gap-y-1">${
        [...input].map(ch => charCell(ch, '', false, null)).join('')
      }</span>`;
    }

    const iChars = [...input];
    const oChars = [...output];
    let html = '';
    let i = 0, o = 0;

    while (i < iChars.length) {
      const ic = iChars[i];
      const oc = oChars[o];

      if (o >= oChars.length || ic !== oc) {
        // Sara Am composition: highlight both source chars red
        if (
          ic.codePointAt(0) === NIKHAHIT &&
          i + 1 < iChars.length &&
          iChars[i + 1].codePointAt(0) === SARA_AA &&
          oc && oc.codePointAt(0) === SARA_AM
        ) {
          html += charCell(ic,        'bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400', true, '→ composed into อำ');
          html += charCell(iChars[i+1],'bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400', true, '→ composed into อำ');
          i += 2; o++;
          continue;
        }
        // Dropped char (duplicate tone etc.)
        const cp = ic.codePointAt(0);
        const name = TONE_MARKS.has(cp) ? 'duplicate tone mark' : cpLabel(ic);
        html += charCell(ic, 'bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400', true, `removed: ${name}`);
        i++;
        continue;
      }

      html += charCell(ic, '', false, null);
      i++; o++;
    }

    return `<span class="text-slate-800 dark:text-slate-100 not-italic${showUnicode ? ' inline-flex flex-wrap gap-y-1' : ''}">${html}</span>`;
  }

  function buildAfterHtml(input, output) {
    if (input === output) {
      if (!showUnicode) return `<span class="text-slate-800 dark:text-slate-100 not-italic">${esc(output)}</span>`;
      return `<span class="text-slate-800 dark:text-slate-100 not-italic inline-flex flex-wrap gap-y-1">${
        [...output].map(ch => charCell(ch, '', false, null)).join('')
      }</span>`;
    }

    const iChars = [...input];
    const oChars = [...output];
    let html = '';
    let i = 0, o = 0;

    while (i < iChars.length) {
      const ic = iChars[i];
      const oc = oChars[o];

      if (o >= oChars.length) { i++; continue; }

      if (ic === oc) {
        html += charCell(ic, '', false, null);
        i++; o++;
        continue;
      }

      // Sara Am composition
      if (
        ic.codePointAt(0) === NIKHAHIT &&
        i + 1 < iChars.length &&
        iChars[i + 1].codePointAt(0) === SARA_AA &&
        oc.codePointAt(0) === SARA_AM
      ) {
        html += charCell(oc, 'bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-400', false, 'composed: อํ + า → อำ');
        i += 2; o++;
        continue;
      }

      // Dropped — skip in input, don't emit in after
      i++;
    }

    while (o < oChars.length) { html += charCell(oChars[o++], '', false, null); }

    return `<span class="text-slate-800 dark:text-slate-100 not-italic${showUnicode ? ' inline-flex flex-wrap gap-y-1' : ''}">${html}</span>`;
  }

  // ---------------------------------------------------------------------------
  // Render
  // ---------------------------------------------------------------------------

  function render() {
    const input  = lastInput;
    const output = lastOutput;
    const beforeEl = document.getElementById('norm-before');
    const afterEl  = document.getElementById('norm-after');
    const empty = '<span class="select-none text-slate-400 dark:text-slate-500 italic">—</span>';

    if (!input) {
      beforeEl.innerHTML = empty;
      afterEl.innerHTML  = empty;
      return;
    }

    beforeEl.innerHTML = buildBeforeHtml(input, output);
    afterEl.innerHTML  = buildAfterHtml(input, output);
  }

  async function run() {
    const input    = document.getElementById('norm-input').value;
    const statusEl = document.getElementById('norm-status');
    const legendEl = document.getElementById('norm-legend');

    lastInput  = input;
    lastOutput = input; // default — overwritten below

    if (!input) {
      statusEl.textContent = '';
      legendEl.classList.add('hidden');
      render();
      return;
    }

    try {
      const mod    = await loadWasm();
      const output = mod.normalize(input);
      lastOutput   = output;

      if (input === output) {
        statusEl.textContent = 'Already normalized ✓';
        statusEl.className   = 'text-xs font-medium text-emerald-600 dark:text-emerald-400';
        legendEl.classList.add('hidden');
      } else {
        const delta = [...input].length - [...output].length;
        statusEl.textContent = delta === 1 ? '1 char removed' : `${delta} chars removed`;
        statusEl.className   = 'text-xs font-medium text-amber-600 dark:text-amber-400';
        legendEl.classList.remove('hidden');
      }
    } catch (err) {
      console.error('kham normalize error:', err);
      statusEl.textContent = '';
      legendEl.classList.add('hidden');
    }

    render();
  }

  // ---------------------------------------------------------------------------
  // Toggle
  // ---------------------------------------------------------------------------

  function updateToggle() {
    const btn = document.getElementById('norm-unicode-toggle');
    if (!btn) return;
    if (showUnicode) {
      btn.setAttribute('aria-pressed', 'true');
      btn.className = 'text-xs font-medium px-3 py-1.5 rounded-lg border border-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 transition-colors';
    } else {
      btn.setAttribute('aria-pressed', 'false');
      btn.className = 'text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-500 dark:text-slate-400 hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors';
    }
  }

  // ---------------------------------------------------------------------------
  // Boot
  // ---------------------------------------------------------------------------

  document.addEventListener('DOMContentLoaded', () => {
    // Inject example buttons (JS strings preserve exact codepoints)
    const container = document.getElementById('norm-examples');
    if (container) {
      EXAMPLES.forEach(e => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = e.label;
        btn.className = 'text-xs px-3 py-1.5 rounded-md bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 transition-colors';
        btn.addEventListener('click', () => {
          document.getElementById('norm-input').value = e.raw;
          run();
        });
        container.appendChild(btn);
      });
    }

    document.getElementById('norm-input')?.addEventListener('input', run);

    document.getElementById('norm-unicode-toggle')?.addEventListener('click', () => {
      showUnicode = !showUnicode;
      updateToggle();
      render();
    });

    loadWasm().catch(() => {});
  });
})();
</script>
