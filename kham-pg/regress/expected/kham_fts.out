-- kham_fts — pg_regress integration tests for the kham-pg extension.
--
-- Run via:  make -C kham-pg regress   (uses Docker PostgreSQL 17)
-- ── 1. Load extension ────────────────────────────────────────────────────────
CREATE EXTENSION kham_pg;
-- ── 2. Verify lextypes ───────────────────────────────────────────────────────
SELECT tokid, alias, description
FROM ts_token_type('kham')
ORDER BY tokid;
 tokid |  alias  |     description     
-------+---------+---------------------
     1 | thai    | Thai word
     2 | latin   | Latin script token
     3 | number  | Numeric token
     4 | punct   | Punctuation
     5 | emoji   | Emoji token
     6 | unknown | Unknown / OOV token
     7 | named   | Named entity token
(7 rows)

-- ── 3. ts_parse — pure Thai ──────────────────────────────────────────────────
SELECT tokid, token
FROM ts_parse('kham', 'กินข้าว')
ORDER BY tokid, token;
 tokid | token 
-------+-------
     1 | กินข้าว
(1 row)

-- ── 4. ts_parse — Thai sentence with stopword ────────────────────────────────
SELECT tokid, token
FROM ts_parse('kham', 'กินข้าวกับปลา')
ORDER BY tokid, token;
 tokid | token 
-------+-------
     1 | กับ
     1 | กินข้าว
     1 | ปลา
(3 rows)

-- ── 5. ts_parse — mixed Thai + Latin + number ────────────────────────────────
SELECT tokid, token
FROM ts_parse('kham', 'Python 3 สำหรับ AI')
ORDER BY tokid, token;
 tokid | token  
-------+--------
     1 | สำหรับ
     2 | AI
     2 | Python
     3 | 3
(4 rows)

-- ── 6. ts_parse — empty string returns no rows ───────────────────────────────
SELECT count(*) FROM ts_parse('kham', '');
 count 
-------
     0
(1 row)

-- ── 7. to_tsvector — non-null result ────────────────────────────────────────
SELECT to_tsvector('kham', 'กินข้าวกับปลา') IS NOT NULL AS ok;
 ok 
----
 t
(1 row)

-- ── 8. Phrase search — token present in document ────────────────────────────
SELECT to_tsvector('kham', 'กินข้าวกับปลา') @@ plainto_tsquery('kham', 'ปลา') AS found;
 found 
-------
 t
(1 row)

-- ── 9. Phrase search — token NOT in document ────────────────────────────────
SELECT to_tsvector('kham', 'กินข้าวกับปลา') @@ plainto_tsquery('kham', 'หมา') AS found;
 found 
-------
 f
(1 row)

-- ── 10. to_tsvector — mixed script ───────────────────────────────────────────
SELECT to_tsvector('kham', 'โปรแกรม Python') IS NOT NULL AS ok;
 ok 
----
 t
(1 row)

-- ── 11. tsvector lexeme content — pure Thai (exact positions) ────────────────
SELECT to_tsvector('kham', 'กินข้าว')::text;
    to_tsvector     
--------------------
 '1619':1 'กินข้าว':1
(1 row)

-- ── 12. tsvector — stopword suppressed, content words retained ────────────────
SELECT
    ('กับ' NOT IN (SELECT lexeme FROM unnest(to_tsvector('kham', 'กินข้าวกับปลา')))) AS stopword_suppressed,
    ('ปลา' IN     (SELECT lexeme FROM unnest(to_tsvector('kham', 'กินข้าวกับปลา')))) AS content_indexed;
 stopword_suppressed | content_indexed 
---------------------+-----------------
 t                   | t
(1 row)

-- ── 13. to_tsquery — single word match ───────────────────────────────────────
SELECT to_tsvector('kham', 'กินข้าวกับปลา') @@ to_tsquery('kham', 'กินข้าว') AS found;
 found 
-------
 t
(1 row)

-- ── 14. to_tsquery — no match ────────────────────────────────────────────────
SELECT to_tsvector('kham', 'กินข้าวกับปลา') @@ to_tsquery('kham', 'หมู') AS found;
 found 
-------
 f
(1 row)

-- ── 15. to_tsquery — Latin token match (simple dict lowercases) ──────────────
SELECT to_tsvector('kham', 'Python สำหรับ AI') @@ to_tsquery('kham', 'python') AS found;
 found 
-------
 t
(1 row)

-- ── 16. Table FTS with GIN index ─────────────────────────────────────────────
CREATE TABLE kham_docs (
    id   integer,
    body text
);
INSERT INTO kham_docs VALUES
    (1, 'กินข้าวที่บ้าน'),
    (2, 'ดื่มน้ำสะอาด'),
    (3, 'Python สำหรับนักพัฒนา');
CREATE INDEX kham_docs_fts_idx ON kham_docs
    USING GIN (to_tsvector('kham', body));
-- search Thai token — must return only row 1
SELECT id
FROM kham_docs
WHERE to_tsvector('kham', body) @@ plainto_tsquery('kham', 'กินข้าว')
ORDER BY id;
 id 
----
  1
(1 row)

-- ── 17. GIN index — Latin token search ───────────────────────────────────────
-- search Latin token — must return only row 3
SELECT id
FROM kham_docs
WHERE to_tsvector('kham', body) @@ plainto_tsquery('kham', 'Python')
ORDER BY id;
 id 
----
  3
(1 row)

-- ── 18. GIN index — no match ─────────────────────────────────────────────────
SELECT id
FROM kham_docs
WHERE to_tsvector('kham', body) @@ plainto_tsquery('kham', 'หมู')
ORDER BY id;
 id 
----
(0 rows)

-- ── 19. ts_rank — non-zero for matching document ─────────────────────────────
SELECT ts_rank(
    to_tsvector('kham', 'กินข้าวกับปลา'),
    plainto_tsquery('kham', 'ปลา')
) > 0 AS ranked;
 ranked 
--------
 t
(1 row)

-- ── 20. Named entity — ts_parse returns tokid=7 ──────────────────────────────
-- จีน is in the NE gazetteer as PLACE; single syllable → always one token
SELECT tokid, token
FROM ts_parse('kham', 'จีน')
ORDER BY tokid, token;
 tokid | token 
-------+-------
     7 | จีน
(1 row)

-- ── 21. Named entity — to_tsvector indexes the token ────────────────────────
SELECT to_tsvector('kham', 'ไปจีน') @@ to_tsquery('kham', 'จีน') AS found;
 found 
-------
 t
(1 row)

-- ── 22. lextypes — parser exposes 7 token types ──────────────────────────────
SELECT count(*) AS lextype_count
FROM ts_token_type('kham');
 lextype_count 
---------------
             7
(1 row)

-- ── 23. ts_headline — matched word is wrapped in default <b> tags ─────────────
SELECT ts_headline('kham', 'กินข้าวกับปลา', to_tsquery('kham', 'ปลา'));
    ts_headline    
-------------------
 กินข้าวกับ<b>ปลา</b>
(1 row)

-- ── 24. ts_headline — custom start/stop tags ─────────────────────────────────
SELECT ts_headline('kham', 'กินข้าวกับปลา', to_tsquery('kham', 'ปลา'),
                   'StartSel=<<, StopSel=>>');
  ts_headline   
----------------
 กินข้าวกับ<<ปลา>>
(1 row)

-- ── 25. ts_headline — Latin token match ──────────────────────────────────────
SELECT ts_headline('kham', 'โปรแกรม Python สำหรับ AI',
                   to_tsquery('kham', 'python'),
                   'StartSel=<<, StopSel=>>');
       ts_headline        
--------------------------
 โปรแกรม<<Python>>สำหรับAI
(1 row)

-- ── 26. ts_headline — named entity highlighted ────────────────────────────────
SELECT ts_headline('kham', 'เดินทางไปจีน', to_tsquery('kham', 'จีน'),
                   'StartSel=<<, StopSel=>>');
  ts_headline   
----------------
 เดินทางไป<<จีน>>
(1 row)

-- ── 27. ts_headline — no match returns plain document ────────────────────────
SELECT ts_headline('kham', 'กินข้าวกับปลา', to_tsquery('kham', 'หมู'),
                   'StartSel=<<, StopSel=>>') = 'กินข้าวกับปลา' AS unchanged;
 unchanged 
-----------
 t
(1 row)

-- ── 28. kham_fts_dict — Thai word expands to word + soundex + RTGS lexemes ───
-- Verify that ปลา, its lk82 soundex code, and its RTGS romanization are all
-- stored as colocated lexemes in the tsvector.
SELECT
    ('ปลา' IN (SELECT lexeme FROM unnest(to_tsvector('kham', 'ปลา')))) AS word_indexed,
    EXISTS (SELECT 1 FROM unnest(to_tsvector('kham', 'ปลา')) WHERE lexeme ~ '^[0-9]') AS soundex_indexed,
    ('pla' IN (SELECT lexeme FROM unnest(to_tsvector('kham', 'ปลา')))) AS rtgs_indexed;
 word_indexed | soundex_indexed | rtgs_indexed 
--------------+-----------------+--------------
 t            | t               | t
(1 row)

-- ── 29. Soundex search — find Thai word by its lk82 phonetic code ─────────────
-- The soundex code for 'ปลา' should be stored as a lexeme in the tsvector.
SELECT to_tsvector('kham', 'กินข้าวกับปลา') @@
       to_tsquery('kham', (
           SELECT lexeme
           FROM unnest(to_tsvector('kham', 'ปลา'))
           WHERE lexeme ~ '^[0-9]'
           LIMIT 1
       )) AS found_by_soundex;
 found_by_soundex 
------------------
 t
(1 row)

-- ── 30. RTGS search — find Thai word by its romanized form ───────────────────
-- If 'ปลา' has an RTGS entry (e.g. 'pla'), search should find the document.
-- If no RTGS entry exists for this word the query returns no rows (expected).
SELECT to_tsvector('kham', 'กินข้าวกับปลา') @@
       plainto_tsquery('kham', 'pla') AS found_by_rtgs;
 found_by_rtgs 
---------------
 t
(1 row)

-- ── 31. kham_fts_dict — tsvector has multiple lexemes per Thai token ──────────
SELECT array_length(array_agg(lexeme), 1) >= 2 AS has_synonyms
FROM unnest(to_tsvector('kham', 'ปลา'));
 has_synonyms 
--------------
 t
(1 row)

