---
const algorithms = [
  { id: 'lk82',      label: 'LK82',      desc: '12 consonant groups · 4-char code · most widely used' },
  { id: 'udom83',    label: 'Udom83',    desc: '14 groups · finer sibilant distinctions · 4-char code' },
  { id: 'metasound', label: 'MetaSound', desc: 'Per-syllable encoding · 3 chars / syllable · variable length' },
];

const examples = [
  { a: 'กาน', b: 'ขาน',  label: 'กาน / ขาน' },
  { a: 'กิน', b: 'คิน',  label: 'กิน / คิน' },
  { a: 'สาน', b: 'ซาน',  label: 'สาน / ซาน' },
];
---

<div class="soundex-root font-sans">
  <!-- Header row: title + algo tabs -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
      <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Phonetic Soundex</h2>
      <p id="soundex-algo-desc" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
        {algorithms[0].desc}
      </p>
    </div>
    <div class="inline-flex items-center bg-slate-100 dark:bg-slate-800 rounded-lg p-1 gap-0.5" role="group" aria-label="Soundex algorithm">
      {algorithms.map((a, i) => (
        <button
          type="button"
          class="soundex-algo-tab text-xs font-medium px-3 py-1.5 rounded-md transition-colors"
          data-algo={a.id}
          data-desc={a.desc}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {a.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Word inputs + codes -->
  <div class="grid grid-cols-[1fr_auto_1fr] items-start gap-4 mb-5">
    <!-- Word 1 -->
    <div>
      <label for="soundex-word1" class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5">Word 1</label>
      <input
        id="soundex-word1"
        type="text"
        placeholder="พิมพ์คำภาษาไทย…"
        aria-label="First Thai word"
        class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3 py-2 text-base font-sans focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder:text-slate-400"
      />
      <div class="mt-3 min-h-[56px] flex flex-col items-center justify-center rounded-lg bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 px-3 py-2">
        <span class="text-[10px] uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-0.5">Code</span>
        <span id="soundex-code1" class="text-2xl font-mono font-bold text-slate-300 dark:text-slate-600">—</span>
      </div>
    </div>

    <!-- VS divider -->
    <div class="flex flex-col items-center justify-start pt-8 gap-2">
      <span class="text-xs font-semibold text-slate-400 dark:text-slate-500">vs</span>
      <div id="soundex-match-icon" class="hidden w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold" aria-live="polite"></div>
    </div>

    <!-- Word 2 -->
    <div>
      <label for="soundex-word2" class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5">Word 2</label>
      <input
        id="soundex-word2"
        type="text"
        placeholder="พิมพ์คำภาษาไทย…"
        aria-label="Second Thai word"
        class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3 py-2 text-base font-sans focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder:text-slate-400"
      />
      <div class="mt-3 min-h-[56px] flex flex-col items-center justify-center rounded-lg bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 px-3 py-2">
        <span class="text-[10px] uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-0.5">Code</span>
        <span id="soundex-code2" class="text-2xl font-mono font-bold text-slate-300 dark:text-slate-600">—</span>
      </div>
    </div>
  </div>

  <!-- Match result banner -->
  <div id="soundex-result" class="hidden rounded-lg px-4 py-3 text-sm font-medium text-center" aria-live="polite"></div>

  <!-- Quick examples -->
  <div class="flex flex-wrap items-center gap-2 mt-4">
    <span class="text-xs text-slate-500 dark:text-slate-400">Try:</span>
    {examples.map(e => (
      <button
        type="button"
        class="soundex-example text-xs px-3 py-1.5 rounded-md bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 transition-colors font-mono"
        data-a={e.a}
        data-b={e.b}
        aria-label={`Try example: ${e.label}`}
      >
        {e.label}
      </button>
    ))}
  </div>
</div>

<script is:inline>
(function () {
  let wasmMod  = null;
  let activeAlgo = 'lk82';

  async function loadWasm() {
    if (wasmMod) return wasmMod;
    const mod = await import('/wasm/kham_wasm.js');
    await mod.default();
    wasmMod = mod;
    return wasmMod;
  }

  function updateAlgoTabs() {
    const descEl = document.getElementById('soundex-algo-desc');
    document.querySelectorAll('.soundex-algo-tab').forEach(btn => {
      const active = btn.dataset.algo === activeAlgo;
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      btn.className = `soundex-algo-tab text-xs font-medium px-3 py-1.5 rounded-md transition-colors ${
        active
          ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 shadow-sm'
          : 'text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300'
      }`;
      if (active && descEl) descEl.textContent = btn.dataset.desc;
    });
  }

  async function compute() {
    const w1 = document.getElementById('soundex-word1').value.trim();
    const w2 = document.getElementById('soundex-word2').value.trim();

    const code1El   = document.getElementById('soundex-code1');
    const code2El   = document.getElementById('soundex-code2');
    const resultEl  = document.getElementById('soundex-result');
    const iconEl    = document.getElementById('soundex-match-icon');

    if (!w1 && !w2) {
      code1El.textContent = '—'; code1El.className = 'text-2xl font-mono font-bold text-slate-300 dark:text-slate-600';
      code2El.textContent = '—'; code2El.className = 'text-2xl font-mono font-bold text-slate-300 dark:text-slate-600';
      resultEl.classList.add('hidden');
      iconEl.classList.add('hidden');
      return;
    }

    try {
      const mod = await loadWasm();

      const c1 = w1 ? mod.soundex_word(w1, activeAlgo) : null;
      const c2 = w2 ? mod.soundex_word(w2, activeAlgo) : null;

      if (c1) {
        code1El.textContent = c1;
        code1El.className = 'text-2xl font-mono font-bold text-blue-600 dark:text-blue-400';
      } else {
        code1El.textContent = '—';
        code1El.className = 'text-2xl font-mono font-bold text-slate-300 dark:text-slate-600';
      }

      if (c2) {
        code2El.textContent = c2;
        code2El.className = 'text-2xl font-mono font-bold text-blue-600 dark:text-blue-400';
      } else {
        code2El.textContent = '—';
        code2El.className = 'text-2xl font-mono font-bold text-slate-300 dark:text-slate-600';
      }

      if (c1 && c2) {
        const match = c1 === c2;
        iconEl.classList.remove('hidden');
        iconEl.textContent = match ? '✓' : '✗';
        iconEl.className = `w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold ${
          match
            ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-400'
            : 'bg-red-100 text-red-600 dark:bg-red-900/40 dark:text-red-400'
        }`;

        resultEl.classList.remove('hidden');
        if (match) {
          resultEl.textContent = `"${w1}" and "${w2}" share the same ${activeAlgo.toUpperCase()} code — they sound alike.`;
          resultEl.className = 'rounded-lg px-4 py-3 text-sm font-medium text-center bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/30 dark:text-emerald-300 dark:border-emerald-800';
        } else {
          resultEl.textContent = `"${w1}" (${c1}) and "${w2}" (${c2}) have different codes — they sound different.`;
          resultEl.className = 'rounded-lg px-4 py-3 text-sm font-medium text-center bg-slate-50 text-slate-600 border border-slate-200 dark:bg-slate-800/50 dark:text-slate-400 dark:border-slate-700';
        }
      } else {
        resultEl.classList.add('hidden');
        iconEl.classList.add('hidden');
      }
    } catch (err) {
      console.error('kham soundex error:', err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateAlgoTabs();

    document.getElementById('soundex-word1')?.addEventListener('input', compute);
    document.getElementById('soundex-word2')?.addEventListener('input', compute);

    document.querySelectorAll('.soundex-algo-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        activeAlgo = btn.dataset.algo;
        updateAlgoTabs();
        compute();
      });
    });

    document.querySelectorAll('.soundex-example').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('soundex-word1').value = btn.dataset.a;
        document.getElementById('soundex-word2').value = btn.dataset.b;
        compute();
      });
    });

    loadWasm().catch(() => {});
  });
})();
</script>
