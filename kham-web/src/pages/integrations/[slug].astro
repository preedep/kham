        { '@type': 'HowToStep', position: 3, name: 'Create FTS5 table', text: "CREATE VIRTUAL TABLE docs USING fts5(body, tokenize='kham');" },
        { '@type': 'HowToStep', position: 4, name: 'Search', text: "SELECT * FROM docs WHERE docs MATCH 'ปลา';" },
      ],
    },
  ],
  python: [
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://kham.io/' },
        { '@type': 'ListItem', position: 2, name: 'Getting Started', item: 'https://kham.io/getting-started' },
        { '@type': 'ListItem', position: 3, name: 'Python', item: 'https://kham.io/integrations/python' },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: 'How to Use Thai NLP in Python with kham',
      description: 'Install kham via pip and use segment(), segment_tokens(), spell_suggestions(), and extract_keywords().',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Install', text: 'pip install kham' },
        { '@type': 'HowToStep', position: 2, name: 'Segment text', text: "import kham; words = kham.segment('กินข้าวกับปลา')" },
        { '@type': 'HowToStep', position: 3, name: 'Get rich tokens', text: "tokens = kham.segment_tokens('กินข้าวกับปลา')" },
        { '@type': 'HowToStep', position: 4, name: 'Spell check', text: "suggs = kham.spell_suggestions('กีนข้าว', 5)" },
      ],
    },
  ],
  wasm: [
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://kham.io/' },
        { '@type': 'ListItem', position: 2, name: 'Getting Started', item: 'https://kham.io/getting-started' },
        { '@type': 'ListItem', position: 3, name: 'WebAssembly / npm', item: 'https://kham.io/integrations/wasm' },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: 'How to Use Thai Word Segmentation in the Browser (WASM)',
      description: 'Install kham-wasm from npm and call segment() or segment_tokens() in any JavaScript or TypeScript project.',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Install', text: 'npm install kham-wasm' },
        { '@type': 'HowToStep', position: 2, name: 'Initialise WASM', text: "import init, { segment } from 'kham-wasm'; await init();" },
        { '@type': 'HowToStep', position: 3, name: 'Segment text', text: "const words = segment('กินข้าวกับปลา');" },
      ],
    },
  ],
};

const { slug } = Astro.params;
const data = integrations[slug as keyof typeof integrations];
---

<Layout
  title={`${data.title} Integration — kham`}
  description={data.description}
  keywords={slugKeywords[slug as keyof typeof slugKeywords]}
  jsonLd={slugJsonLd[slug as keyof typeof slugJsonLd]}
  lang="en"
>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 dark:text-slate-400 mb-8" aria-label="Breadcrumb">
      <a href="/getting-started" class="hover:text-slate-800 dark:hover:text-slate-200 transition-colors">Getting Started</a>
      <span class="mx-2">/</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium">{data.title}</span>
    </nav>

    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-4xl">{data.icon}</span>
        <h1 class="text-4xl font-bold text-slate-900 dark:text-slate-100">{data.title}</h1>
      </div>
      <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl">{data.description}</p>
    </div>

    <!-- Sections -->
    <div class="space-y-14">
      {data.sections.map((section, i) => (
        <section>
          <div class="flex items-center gap-3 mb-3">
            <span class="flex-none w-7 h-7 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400 text-xs font-bold flex items-center justify-center">
              {i + 1}
            </span>
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100">{section.heading}</h2>
          </div>
          {section.body && (
            <p class="text-slate-600 dark:text-slate-400 mb-4 ml-10">{section.body}</p>
          )}
          <div class="ml-10">
            {section.tabs ? (
              <CodeBlock tabs={section.tabs} />
            ) : (
              <CodeBlock code={section.code} lang={section.lang} label={section.label} />
            )}
          </div>
        </section>
      ))}
    </div>

    <!-- Footer nav -->
    <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-700 flex justify-between text-sm">
      <a href="/getting-started" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium transition-colors">
        ← All targets
      </a>
      <a href="/demo" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium transition-colors">
        Try the live demo →
      </a>
    </div>
  </div>
</Layout>
