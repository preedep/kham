---
import Layout from '../../../layouts/Layout.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import { useTranslations } from '../../../i18n/utils';

const t = useTranslations('th');

const modules = [
  { id: 'tokenizer',  label: 'Tokenizer',        path: 'kham_core::Tokenizer',                   desc: 'ตัดคำภาษาไทยด้วย Maximal Matching บน DAWG dictionary ในตัว' },
  { id: 'token',      label: 'Token / TokenKind', path: 'kham_core::Token',                       desc: 'Token แบบ zero-copy พร้อม byte span, char span และประเภทอักษร' },
  { id: 'normalizer', label: 'normalizer',        path: 'kham_core::normalizer',                  desc: 'ปรับมาตรฐานข้อความไทย: ลบวรรณยุกต์ซ้ำ, รวม sara am' },
  { id: 'fts',        label: 'FtsTokenizer',      path: 'kham_core::fts::FtsTokenizer',           desc: 'pipeline FTS: stopwords, synonyms, POS, NE, soundex ในครั้งเดียว' },
  { id: 'pos',        label: 'PosTagger',         path: 'kham_core::pos::PosTagger',              desc: 'POS tagger 13 หมวดหมู่ มาจาก ORCHID tagset' },
  { id: 'ne',         label: 'NeTagger',          path: 'kham_core::ne::NeTagger',                desc: 'จดจำ Named Entity: บุคคล สถานที่ องค์กร' },
  { id: 'romanizer',  label: 'RomanizationMap',   path: 'kham_core::romanizer',                   desc: 'แปลงคำภาษาไทยเป็นอักษรโรมัน RTGS' },
  { id: 'number',     label: 'number',            path: 'kham_core::number',                      desc: 'จัดการตัวเลขภาษาไทย: แปลงหลัก, อ่านจำนวน, ข้อความบาท' },
  { id: 'sentence',   label: 'sentence',          path: 'kham_core::sentence',                    desc: 'ตรวจหาจุดสิ้นสุดประโยค แบ่งย่อหน้าเป็นประโยค' },
  { id: 'soundex',    label: 'soundex',           path: 'kham_core::soundex',                     desc: 'Phonetic codes: lk82, udom83, MetaSound และ cross-language ไทย–อังกฤษ' },
  { id: 'spell',      label: 'SpellChecker',      path: 'kham_core::spell::SpellChecker',         desc: 'แก้คำสะกดผิด: หา candidate ระยะ Levenshtein ≤ 2 จัดอันดับด้วย lk82 + TNC frequency' },
  { id: 'keyword',    label: 'KeyExtractor',      path: 'kham_core::keyword::KeyExtractor',       desc: 'สกัดคำสำคัญ: TF × inverse-corpus-frequency, ตัด stopword ออก' },
];
---

<Layout title="อ้างอิง API — kham" lang="th" description={t('api.desc')}
  keywords="kham API, kham-core Rust API, NLP ภาษาไทย API, Tokenizer, FtsTokenizer, SpellChecker, KeyExtractor, soundex ไทย, RTGS romanization, kham Python API, kham WASM API"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'kham API Reference',
    description: 'เอกสาร API ครบถ้วนสำหรับ kham-core — Rust, Python, WASM และ C FFI สำหรับ NLP ภาษาไทย',
    url: 'https://kham.io/th/api',
    inLanguage: 'th',
    author: { '@type': 'Organization', name: 'kham contributors', url: 'https://github.com/preedep/kham' },
    about: { '@type': 'SoftwareApplication', name: 'kham', applicationCategory: 'DeveloperApplication' },
  }}
>
  <div class="max-w-6xl mx-auto px-6 py-16">

    <!-- Header -->
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-2">
        <h1 class="text-4xl font-bold text-slate-900 dark:text-slate-100">{t('api.title')}</h1>
        <span class="text-sm font-medium px-2.5 py-1 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-full">v0.7.0</span>
      </div>
      <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mb-3">
        {t('api.desc')}
      </p>
      <div class="flex flex-wrap gap-2 text-xs">
        <a href="https://docs.rs/kham-core" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
          docs.rs/kham-core ↗
        </a>
        <a href="https://pypi.org/project/kham" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
          PyPI: kham ↗
        </a>
        <a href="https://www.npmjs.com/package/kham-wasm" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
          npm: kham-wasm ↗
        </a>
        <a href="https://github.com/preedep/kham/tree/main/kham-capi/include/kham.h" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
          kham.h (C FFI) ↗
        </a>
      </div>
    </div>

    <!-- Module table -->
    <div class="mb-16 overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700">
      <table class="w-full text-sm text-left">
        <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700">
          <tr>
            <th class="px-5 py-3 font-semibold text-slate-600 dark:text-slate-400">{t('api.table.module')}</th>
            <th class="px-5 py-3 font-semibold text-slate-600 dark:text-slate-400 hidden md:table-cell">{t('api.table.path')}</th>
            <th class="px-5 py-3 font-semibold text-slate-600 dark:text-slate-400">{t('api.table.desc')}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          {modules.map(m => (
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
              <td class="px-5 py-3 font-medium">
                <a href={`#${m.id}`} class="text-blue-600 dark:text-blue-400 hover:underline font-mono text-sm">{m.label}</a>
              </td>
              <td class="px-5 py-3 hidden md:table-cell">
                <code class="text-xs text-slate-500 dark:text-slate-400">{m.path}</code>
              </td>
              <td class="px-5 py-3 text-slate-600 dark:text-slate-400">{m.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Sections -->
    <div class="space-y-24">

      <!-- ── Tokenizer ── -->
      <section id="tokenizer" class="scroll-mt-24">
        <div class="flex items-start justify-between gap-4 mb-3">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 font-mono">Tokenizer</h2>
          <a href="https://docs.rs/kham-core/latest/kham_core/struct.Tokenizer.html" target="_blank" rel="noopener noreferrer"
             class="shrink-0 text-xs text-slate-500 hover:text-blue-600 transition-colors mt-1.5">docs.rs ↗</a>
        </div>
        <p class="text-slate-600 dark:text-slate-400 mb-4">
          ตัวตัดคำหลักใช้ DAWG dictionary ในตัวและตารางความถี่ TNC ประมวลผลด้วยอัลกอริทึม newmm (maximal matching) ร่วมกับ TCC boundary
          Token ทุกตัวเป็น <strong>zero-copy</strong> slice ของ input string
        </p>
        <CodeBlock
          tabs={[
            {
              label: 'Rust',
              lang: 'rust',
              code: `use kham_core::Tokenizer;

let tok = Tokenizer::new();

// ง่าย — list ของ string
let words: Vec<&str> = tok.segment("กินข้าวกับปลา")
    .into_iter().map(|t| t.text).collect();
// ["กิน", "ข้าว", "กับ", "ปลา"]

// รายละเอียด — Token struct พร้อม span
let tokens = tok.segment("ธนาคาร100แห่ง");
for t in &tokens {
    println!("{:8} chars={}..{} kind={:?}", t.text,
        t.char_span.start, t.char_span.end, t.kind);
}

// dictionary เอง — merge กับ built-in
let tok2 = Tokenizer::builder()
    .dict_words("ปัญญาประดิษฐ์\\nแมชชีนเลิร์นนิง\\n")
    .build();`,
            },
            {
              label: 'Python',
              lang: 'python',
              code: `import kham

# ง่าย — list ของ string
words = kham.segment("กินข้าวกับปลา")
# ['กิน', 'ข้าว', 'กับ', 'ปลา']

# รายละเอียด — Token object (text, byte_start/end, char_start/end, kind)
for t in kham.segment_tokens("ธนาคาร100แห่ง"):
    print(t.text, t.char_start, t.char_end, t.kind)
# ธนาคาร  0  6  Thai
# 100      6  9  Number
# แห่ง     9 13  Thai

# normalize ก่อน segment
text = kham.normalize("ข้้าว")   # "ข้าว"
words = kham.segment(text)`,
            },
            {
              label: 'WASM',
              lang: 'js',
              code: `import init, { segment, segment_tokens, normalize } from '/wasm/kham_wasm.js';
await init(); // เรียกครั้งเดียวตอน load

// ง่าย — JS Array ของ string
const words = segment("กินข้าวกับปลา");
// ["กิน", "ข้าว", "กับ", "ปลา"]

// รายละเอียด — Token (text, charStart, charEnd, byteStart, byteEnd, kind)
const tokens = segment_tokens("ธนาคาร100แห่ง");
for (const t of tokens) {
  console.log(t.text, t.char_start, t.char_end, t.kind);
}

// normalize ก่อน segment
const clean = normalize("ข้้าว");   // "ข้าว"
const toks  = segment(clean);`,
            },
            {
              label: 'C',
              lang: 'c',
              code: `#include "kham.h"

// ง่าย — array ของ token string (legacy API)
KhamTokens *toks = kham_segment("กินข้าวกับปลา");
for (size_t i = 0; i < toks->len; i++)
    printf("%s\\n", toks->words[i]);
kham_tokens_free(toks);

// รายละเอียด — KhamToken พร้อม byte/char span
KhamTokenList *list = kham_segment_tokens("ธนาคาร100แห่ง");
for (size_t i = 0; i < list->len; i++) {
    KhamToken t = list->tokens[i];
    printf("%s  chars=%zu..%zu  %s\\n",
           t.text, t.char_start, t.char_end, t.kind);
}
kham_token_list_free(list);`,
            },
          ]}
        />
        <div class="mt-3 text-sm text-slate-500 dark:text-slate-400">
          <strong>Rust key methods:</strong>
          <code class="mx-1 bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">Tokenizer::new()</code>
          <code class="mx-1 bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">Tokenizer::builder()</code>
          <code class="mx-1 bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">.segment(&amp;str) → Vec&lt;Token&gt;</code>
        </div>
      </section>

      <!-- ── Token / TokenKind ── -->
      <section id="token" class="scroll-mt-24">
        <div class="flex items-start justify-between gap-4 mb-3">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 font-mono">Token / TokenKind</h2>
          <a href="https://docs.rs/kham-core/latest/kham_core/struct.Token.html" target="_blank" rel="noopener noreferrer"
             class="shrink-0 text-xs text-slate-500 hover:text-blue-600 transition-colors mt-1.5">docs.rs ↗</a>
        </div>
        <p class="text-slate-600 dark:text-slate-400 mb-4">
          แต่ละ Token มี <code class="text-sm bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">text</code> (slice ไม่คัดลอก),
          <code class="text-sm bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">span</code> (byte offset),
          <code class="text-sm bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">char_span</code> (Unicode offset) และ
          <code class="text-sm bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">kind</code>
        </p>
        <CodeBlock
          tabs={[
            {
              label: 'Rust',
              lang: 'rust',
              code: `use kham_core::{TokenKind, NamedEntityKind, Tokenizer};

let tok = Tokenizer::new();
let input = "ธนาคาร100แห่ง";
let tokens = tok.segment(input);

for t in &tokens {
    // t.text      — &str (zero-copy slice ของ input)
    // t.span      — Range<usize> byte offsets
    // t.char_span   — Range<usize> Unicode scalar-value offsets
    // t.kind        — TokenKind
    // t.confidence  — f32: 0.0 (Unknown) … 1.0 (dict match ที่มีความมั่นใจสูง)

    assert_eq!(&input[t.span.clone()], t.text);
}

// TokenKind variants:
// Thai | Latin | Number | Punctuation | Emoji | Whitespace | Unknown
// Named(NamedEntityKind::Person | Place | Org)  ← กำหนดโดย NeTagger`,
            },
            {
              label: 'Python',
              lang: 'python',
              code: `import kham

tokens = kham.segment_tokens("ธนาคาร100แห่ง")

for t in tokens:
    # t.text       — str
    # t.byte_start / t.byte_end  — UTF-8 byte offsets
    # t.char_start / t.char_end  — Unicode scalar-value offsets
    # t.kind        — str: "Thai" | "Latin" | "Number" | "Punctuation"
    #                       "Emoji" | "Whitespace" | "Unknown"
    #                       "Person" | "Place" | "Org"  (Named entities)
    # t.confidence  — float: 0.0 (Unknown) … 1.0 (dict match ที่มีความมั่นใจสูง)
    print(f"{t.text!r:12} kind={t.kind}  chars={t.char_start}..{t.char_end}  conf={t.confidence:.2f}")`,
            },
            {
              label: 'WASM',
              lang: 'js',
              code: `import init, { segment_tokens } from '/wasm/kham_wasm.js';
await init();

const tokens = segment_tokens("ธนาคาร100แห่ง");

for (const t of tokens) {
  // t.text       — string
  // t.byte_start / t.byte_end  — UTF-8 byte offsets
  // t.char_start / t.char_end  — Unicode scalar-value offsets
  // t.kind        — "Thai" | "Latin" | "Number" | "Punctuation"
  //                 "Emoji" | "Whitespace" | "Unknown"
  //                 "Person" | "Place" | "Org"  (Named entities)
  // t.confidence  — number: 0.0 (Unknown) … 1.0
  console.log(t.text, t.kind, t.char_start, t.char_end, t.confidence);
}`,
            },
            {
              label: 'C',
              lang: 'c',
              code: `#include "kham.h"

// KhamToken fields:
//   text       — char* (null-terminated UTF-8)
//   byte_start / byte_end  — size_t byte offsets
//   char_start / char_end  — size_t Unicode scalar-value offsets
//   kind       — char*: "Thai" | "Latin" | "Number" | "Punctuation"
//                       "Emoji" | "Whitespace" | "Unknown"
//                       "Person" | "Place" | "Org"  (FTS pipeline เท่านั้น)
//   confidence — float: 0.0 (Unknown) … 1.0

KhamTokenList *list = kham_segment_tokens("ธนาคาร100แห่ง");
for (size_t i = 0; i < list->len; i++) {
    KhamToken *t = &list->tokens[i];
    printf("%-10s  bytes=%zu..%zu  chars=%zu..%zu  kind=%s\\n",
           t->text, t->byte_start, t->byte_end,
           t->char_start, t->char_end, t->kind);
}
kham_token_list_free(list);`,
            },
          ]}
        />
      </section>

      <!-- ── Normalizer ── -->
      <section id="normalizer" class="scroll-mt-24">
        <div class="flex items-start justify-between gap-4 mb-3">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 font-mono">normalizer</h2>
          <a href="https://docs.rs/kham-core/latest/kham_core/normalizer/index.html" target="_blank" rel="noopener noreferrer"
             class="shrink-0 text-xs text-slate-500 hover:text-blue-600 transition-colors mt-1.5">docs.rs ↗</a>
        </div>
        <p class="text-slate-600 dark:text-slate-400 mb-4">
          ปรับมาตรฐานข้อความ 2 กฎ: <strong>(1)</strong> ลบวรรณยุกต์ซ้ำ เก็บตัวสุดท้าย;
          <strong>(2)</strong> รวม nikhahit (อํ U+0E4D) + sara aa (อา U+0E32) เป็น sara am (อำ U+0E33)
          ควรเรียกก่อน segment เมื่อ input อาจมาจากแป้นพิมพ์ผู้ใช้หรือ OCR
        </p>
        <CodeBlock
          tabs={[
            {
              label: 'Rust',
              lang: 'rust',
              code: `use kham_core::normalizer::normalize;

// กฎ 1 — ลบวรรณยุกต์ซ้ำ (เก็บตัวสุดท้าย)
assert_eq!(normalize("ข้้าว"), "ข้าว");   // mai tho ซ้ำ → ตัวเดียว
assert_eq!(normalize("ก่้"),   "ก้");      // mai ek + mai tho → mai tho

// กฎ 2 — รวม sara am
// nikhahit (U+0E4D) + sara aa (U+0E32) → sara am (U+0E33)
let decomposed = "\\u{0E01}\\u{0E4D}\\u{0E32}"; // กํา (สอง codepoint)
assert_eq!(normalize(decomposed), "กำ");          // กำ  (หนึ่ง codepoint)

// canonical อยู่แล้ว — คืนค่าโดยไม่ allocate
assert_eq!(normalize("กินข้าว"), "กินข้าว");`,
            },
            {
              label: 'Python',
              lang: 'python',
              code: `import kham

# กฎ 1 — ลบวรรณยุกต์ซ้ำ
kham.normalize("ข้้าว")   # → "ข้าว"

# กฎ 2 — รวม sara am
# nikhahit (U+0E4D) + sara aa (U+0E32) → sara am (U+0E33)
kham.normalize("\\u0e01\\u0e4d\\u0e32")  # กํา → กำ

# canonical อยู่แล้ว — คืนค่าเดิม
kham.normalize("กินข้าว")  # → "กินข้าว"

# วิธีใช้ทั่วไป: normalize ก่อน segment
words = kham.segment(kham.normalize(raw_input))`,
            },
            {
              label: 'WASM',
              lang: 'js',
              code: `import init, { normalize, segment } from '/wasm/kham_wasm.js';
await init();

// กฎ 1 — ลบวรรณยุกต์ซ้ำ
normalize("ข้้าว");   // → "ข้าว"

// กฎ 2 — รวม sara am
// nikhahit (U+0E4D) + sara aa (U+0E32) → sara am (U+0E33)
normalize("\\u0E01\\u0E4D\\u0E32");  // กํา → กำ

// canonical อยู่แล้ว — คืนค่าเดิม
normalize("กินข้าว");  // → "กินข้าว"

// วิธีใช้ทั่วไป: normalize ก่อน segment
const words = segment(normalize(rawInput));`,
            },
            {
              label: 'C',
              lang: 'c',
              code: `#include "kham.h"

// kham_normalize คืน heap-allocated string — free ด้วย kham_string_free

char *out = kham_normalize("ข้้าว");   // "ข้าว"
printf("%s\\n", out);
kham_string_free(out);

// รวม sara am: nikhahit + sara aa → sara am
char *out2 = kham_normalize("\\xe0\\xb8\\x81\\xe0\\xb9\\x8d\\xe0\\xb8\\xb2"); // กํา
printf("%s\\n", out2);   // กำ
kham_string_free(out2);

// วิธีใช้ทั่วไป: normalize แล้ว segment
char *norm = kham_normalize(raw_input);
KhamTokens *toks = kham_segment(norm);
kham_string_free(norm);
// ... ใช้ toks ...
kham_tokens_free(toks);`,
            },
          ]}
        />
      </section>

      <!-- ── FtsTokenizer ── -->
      <section id="fts" class="scroll-mt-24">
        <div class="flex items-start justify-between gap-4 mb-3">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 font-mono">FtsTokenizer</h2>
          <a href="https://docs.rs/kham-core/latest/kham_core/fts/struct.FtsTokenizer.html" target="_blank" rel="noopener noreferrer"
             class="shrink-0 text-xs text-slate-500 hover:text-blue-600 transition-colors mt-1.5">docs.rs ↗</a>
        </div>
        <p class="text-slate-600 dark:text-slate-400 mb-4">
          รวม NLP pipeline ในครั้งเดียว: normalize → segment → NE → stopwords → POS → synonyms → romanization
          ใน Python และ WASM นี่คือทางหลักในการเข้าถึง POS และ NE metadata
        </p>
        <CodeBlock
          tabs={[
            {
              label: 'Rust',
              lang: 'rust',
              code: `use kham_core::fts::FtsTokenizer;
use kham_core::soundex::SoundexAlgorithm;
use kham_core::synonym::SynonymMap;

// pipeline เริ่มต้น
let fts = FtsTokenizer::new();
let tokens = fts.segment_for_fts("นายกรัฐมนตรีกินข้าว");
for t in &tokens {
    println!("{:8} pos={:?} ne={:?} stop={}", t.text, t.pos, t.ne, t.is_stop);
}

