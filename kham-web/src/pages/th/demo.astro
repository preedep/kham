---
import Layout from '../../layouts/Layout.astro';
import LiveDemo from '../../components/LiveDemo.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('th');
---

<Layout title="ทดลองใช้งาน — kham" description={t('demo.desc')} lang="th">
  <div class="max-w-4xl mx-auto px-6 py-16">
    <div class="mb-10">
      <h1 class="text-4xl font-bold text-slate-900 mb-3">{t('demo.title')}</h1>
      <p class="text-lg text-slate-600 max-w-2xl">{t('demo.desc')}</p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 md:p-8">
      <LiveDemo />
    </div>

    <div class="mt-10 grid sm:grid-cols-3 gap-6 text-sm text-slate-600">
      <div class="bg-slate-50 rounded-xl p-5 border border-slate-200">
        <h3 class="font-semibold text-slate-800 mb-1">{t('demo.kinds.title')}</h3>
        <ul class="space-y-1">
          <li><span class="inline-block w-2 h-2 rounded-full bg-blue-400 mr-1.5"></span>Thai — ภาษาไทย</li>
          <li><span class="inline-block w-2 h-2 rounded-full bg-green-400 mr-1.5"></span>Latin — ภาษาอังกฤษ</li>
          <li><span class="inline-block w-2 h-2 rounded-full bg-yellow-400 mr-1.5"></span>Number — ตัวเลข</li>
          <li><span class="inline-block w-2 h-2 rounded-full bg-slate-400 mr-1.5"></span>Punctuation — เครื่องหมาย</li>
          <li><span class="inline-block w-2 h-2 rounded-full bg-purple-400 mr-1.5"></span>Emoji</li>
        </ul>
      </div>

      <div class="bg-slate-50 rounded-xl p-5 border border-slate-200">
        <h3 class="font-semibold text-slate-800 mb-1">{t('demo.span.title')}</h3>
        <p><strong>Chars</strong> — {t('demo.span.chars')}</p>
        <p class="mt-2"><strong>Bytes</strong> — {t('demo.span.bytes')}</p>
      </div>

      <div class="bg-slate-50 rounded-xl p-5 border border-slate-200">
        <h3 class="font-semibold text-slate-800 mb-1">{t('demo.coming.title')}</h3>
        <ul class="space-y-1">
          <li>POS tagging (13 หมวดหมู่)</li>
          <li>Named Entity Recognition</li>
          <li>Romanization (RTGS)</li>
          <li>Phonetic codes (lk82 / udom83)</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
