---
import Layout from '../../layouts/Layout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const modules = [
  { id: 'tokenizer',  label: 'Tokenizer',        path: 'kham_core::Tokenizer',                   desc: 'Core Thai word segmenter — maximal matching over a built-in DAWG dictionary.' },
  { id: 'token',      label: 'Token / TokenKind', path: 'kham_core::Token',                        desc: 'Zero-copy token slice with byte spans, char spans, and script category.' },
  { id: 'normalizer', label: 'normalizer',        path: 'kham_core::normalizer',                   desc: 'Thai text normalization: deduplicate tone marks, compose sara am (อำ).' },
  { id: 'fts',        label: 'FtsTokenizer',      path: 'kham_core::fts::FtsTokenizer',            desc: 'Full-text search pipeline: stopwords, synonyms, POS, NE, soundex in one call.' },
  { id: 'pos',        label: 'PosTagger',         path: 'kham_core::pos::PosTagger',               desc: '13-category POS tagger derived from the ORCHID tagset.' },
  { id: 'ne',         label: 'NeTagger',          path: 'kham_core::ne::NeTagger',                 desc: 'Named entity recognition: Person, Place, Org via built-in gazetteer.' },
  { id: 'romanizer',  label: 'RomanizationMap',   path: 'kham_core::romanizer',                    desc: 'RTGS romanization lookup — Thai word → Latin transliteration.' },
  { id: 'number',     label: 'number',            path: 'kham_core::number',                       desc: 'Thai numeral utilities: parse Thai digit strings, word-to-number, baht text.' },
  { id: 'sentence',   label: 'sentence',          path: 'kham_core::sentence',                     desc: 'Sentence boundary detection — split a paragraph into sentence spans.' },
  { id: 'soundex',    label: 'soundex',           path: 'kham_core::soundex',                      desc: 'Phonetic codes: lk82, udom83, MetaSound, and cross-language Thai–English.' },
];
---

<Layout
