      <section id="soundex" class="scroll-mt-24">
        <div class="flex items-start justify-between gap-4 mb-2">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 font-mono">soundex</h2>
          <a href="https://docs.rs/kham-core/latest/kham_core/soundex/index.html" target="_blank" rel="noopener noreferrer"
