-- kham_advanced — gap coverage: emoji, setweight field boosting, long documents,
-- Thai numeral search, mixed-script queries, custom ts_rank weights,
-- phonetic table search, ts_stat soundex lexemes, OOV unknown token search.
--
-- Run via:  make -C kham-pg regress   (uses Docker PostgreSQL 17)
CREATE EXTENSION IF NOT EXISTS kham_pg;
NOTICE:  extension "kham_pg" already exists, skipping
-- ── Emoji ─────────────────────────────────────────────────────────────────────
-- 1. Emoji character → tokid=5 in ts_parse
SELECT tokid = 5 AS is_emoji FROM ts_parse('kham', '😀');
 is_emoji 
----------
 t
(1 row)

-- 2. Emoji in mixed Thai+emoji input — emoji token count
SELECT count(*) FILTER (WHERE tokid = 5) AS emoji_count
FROM ts_parse('kham', 'กิน😀ปลา');
 emoji_count 
-------------
           1
(1 row)

-- 3. Emoji has no mapping in kham config → discarded from tsvector entirely
SELECT to_tsvector('kham', '😀') = ''::tsvector AS emoji_not_indexed;
 emoji_not_indexed 
-------------------
 t
(1 row)

-- 4. Thai tokens still indexed correctly in mixed emoji+Thai input
SELECT to_tsvector('kham', 'กิน😀ปลา') @@ plainto_tsquery('kham', 'ปลา') AS found;
 found 
-------
 t
(1 row)

-- ── setweight — field boosting ────────────────────────────────────────────────
-- 5. setweight 'A' produces :A position suffix in tsvector text representation
SELECT setweight(to_tsvector('kham', 'ปลา'), 'A')::text LIKE '%:1A%' AS weight_a_in_text;
 weight_a_in_text 
------------------
 t
(1 row)

-- 6. Weight A ranks higher than weight C for the same token and query
--    Uses ปลา directly (not inside a compound) to guarantee the token is present.
SELECT ts_rank(
    setweight(to_tsvector('kham', 'ปลา'), 'A'),
    plainto_tsquery('kham', 'ปลา')
) > ts_rank(
    setweight(to_tsvector('kham', 'ปลา'), 'C'),
    plainto_tsquery('kham', 'ปลา')
) AS weight_a_ranks_higher_than_c;
 weight_a_ranks_higher_than_c 
------------------------------
 t
(1 row)

-- 7. Field-boosted table: id=1 (ปลา in title) ranks before id=2 (ปลา in body)
CREATE TABLE kham_boosted (id integer, title text, body text);
INSERT INTO kham_boosted VALUES
    (1, 'ปลา',        'กินข้าวกับผัก'),
    (2, 'กินข้าว',   'ปลาสด');
SELECT id
FROM kham_boosted
WHERE (
    setweight(to_tsvector('kham', title), 'A') ||
    setweight(to_tsvector('kham', body), 'C')
) @@ plainto_tsquery('kham', 'ปลา')
ORDER BY ts_rank(
    setweight(to_tsvector('kham', title), 'A') ||
    setweight(to_tsvector('kham', body), 'C'),
    plainto_tsquery('kham', 'ปลา')
) DESC;
 id 
----
  1
  2
(2 rows)

-- ── Long document ─────────────────────────────────────────────────────────────
-- 8. Very long document (~300 bytes) tokenises without error
SELECT to_tsvector('kham', repeat('กินข้าวกับปลา ', 20)) IS NOT NULL AS long_doc_ok;
 long_doc_ok 
-------------
 t
(1 row)

-- 9. Search finds a token in a long document
SELECT to_tsvector('kham', repeat('กินข้าวกับปลา ', 20))
    @@ plainto_tsquery('kham', 'ปลา') AS found_in_long_doc;
 found_in_long_doc 
-------------------
 t
(1 row)

-- ── Thai numeral search ───────────────────────────────────────────────────────
-- 10. Thai numeral ๑๒๓ is indexed as Number and searchable by the same numeral
SELECT to_tsvector('kham', '๑๒๓') @@ plainto_tsquery('kham', '๑๒๓') AS numeral_found;
 numeral_found 
---------------
 t
(1 row)

-- 11. Thai numeral inside a sentence is independently searchable
SELECT to_tsvector('kham', 'ราคา ๑๕๐ บาท')
    @@ plainto_tsquery('kham', '๑๕๐') AS numeral_in_sentence;
 numeral_in_sentence 
---------------------
 t
(1 row)

-- ── Mixed-script queries ──────────────────────────────────────────────────────
-- 12. AND query combining Latin and Thai tokens — both must be present
SELECT to_tsvector('kham', 'Python สำหรับนักพัฒนา')
    @@ to_tsquery('kham', 'python & พัฒนา') AS mixed_and_match;
 mixed_and_match 
-----------------
 t
(1 row)

-- 13. OR query — only the Latin token is present; Thai alternative absent
SELECT to_tsvector('kham', 'Python ยอดเยี่ยม')
    @@ to_tsquery('kham', 'python | ปลา') AS mixed_or_match;
 mixed_or_match 
----------------
 t
(1 row)

-- ── ts_rank with custom weight array ──────────────────────────────────────────
-- 14. Custom weight array {D,C,B,A} as first argument produces non-zero rank
--     Weights must come before the tsvector: ts_rank(float4[], tsvector, tsquery)
SELECT ts_rank(
    '{0.1,0.2,0.4,1.0}'::float4[],
    to_tsvector('kham', 'กินข้าวกับปลา'),
    plainto_tsquery('kham', 'ปลา')
) > 0 AS custom_weight_ranked;
 custom_weight_ranked 
----------------------
 t
(1 row)

-- ── Phonetic (soundex) search across table ────────────────────────────────────
-- 15. lk82 soundex code for ปลา finds every document containing ปลา
--     regardless of which surrounding words appear
CREATE TABLE kham_phonetic (id integer, body text);
INSERT INTO kham_phonetic VALUES
    (1, 'ปลาสด'),
    (2, 'กินข้าว'),
    (3, 'ปลาทะเล');
SELECT count(*) AS soundex_matches
FROM kham_phonetic
WHERE to_tsvector('kham', body) @@
    to_tsquery('kham', (
        SELECT lexeme
        FROM unnest(to_tsvector('kham', 'ปลา'))
        WHERE lexeme ~ '^[0-9]'
        LIMIT 1
    ));
 soundex_matches 
-----------------
               2
(1 row)

-- ── ts_stat soundex lexemes ───────────────────────────────────────────────────
-- 16. ts_stat over a Thai corpus exposes soundex (numeric) lexemes
SELECT count(*) > 0 AS has_soundex_stats
FROM ts_stat($$SELECT to_tsvector('kham', body) FROM kham_phonetic$$)
WHERE word ~ '^[0-9]';
 has_soundex_stats 
-------------------
 t
(1 row)

-- ── OOV / Unknown token search ────────────────────────────────────────────────
-- 17. Unknown (OOV) tokens are indexed via kham_dict (simple) and searchable
--     เปปซี่ → เป(Unknown) + ป(Unknown) + ซี่(Thai); both Unknown parts are indexed
SELECT to_tsvector('kham', 'เปปซี่') @@ to_tsquery('kham', 'เป') AS oov_token_searchable;
 oov_token_searchable 
----------------------
 t
(1 row)


