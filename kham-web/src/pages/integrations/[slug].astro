        heading: 'Spell checking',
        body: 'spell_suggestions(word, maxN) returns dictionary candidates within edit distance 2, ranked by lk82 phonetic similarity and TNC corpus frequency.',
        code: `import init, { spell_suggestions } from 'kham-wasm';
await init();

const suggs = spell_suggestions("กีนข้าว", 5);
for (const s of suggs) {
  console.log(s.word, 'edit:', s.edit_distance,
              'soundex:', s.soundex_match, 'freq:', s.freq_score);
}
// กินข้าว  edit: 1  soundex: true  freq: …

// SpellSuggestion: .word  .edit_distance  .soundex_match  .freq_score`,
        lang: 'typescript',
        label: 'spell.ts',
      },
      {
        heading: 'Keyword extraction',
        body: 'extract_keywords(text, maxN) returns the most distinctive words scored by TF × inverse-corpus-frequency. Stopwords are excluded.',
        code: `import init, { extract_keywords } from 'kham-wasm';
await init();

const text = "นักวิทยาศาสตร์ค้นพบดาวเคราะห์ใหม่ในระบบสุริยะ " +
             "ดาวดวงนี้โคจรอยู่ใกล้ดาวเคราะห์น้อย";

const keywords = extract_keywords(text, 5);
for (const kw of keywords) {
  console.log(kw.word, 'score:', kw.score.toFixed(4), 'count:', kw.count);
}

// Keyword: .word  .score  .count`,
        lang: 'typescript',
        label: 'keywords.ts',
      },
      {
        heading: 'Build from source',
        code: `# Requires Rust + wasm-pack
curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh

git clone https://github.com/preedep/kham
cd kham
wasm-pack build kham-wasm --target web --release
# Output: kham-wasm/pkg/`,
        lang: 'bash',
        label: 'shell',
      },
    ],
  },
};

