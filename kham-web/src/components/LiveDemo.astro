---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const samples = [
  'กินข้าวกับปลา',
  'กรุงเทพมหานครเป็นเมืองหลวงของประเทศไทย',
  'บริษัทไทยออยล์จำกัดมหาชน',
  'นักวิทยาศาสตร์ค้นพบดาวเคราะห์ใหม่ในระบบสุริยะ',
];

const sentenceSamples = [
  'คุณชอบอาหารไทยไหม? ผมชอบต้มยำกุ้งมากที่สุด! อาหารไทยมีรสชาติเผ็ดและหอมมาก',
  'นักวิทยาศาสตร์ค้นพบดาวเคราะห์ใหม่ในระบบสุริยะ\nดาวดวงนี้โคจรอยู่ใกล้ดาวเคราะห์น้อย\nทีมนักวิจัยกำลังศึกษาข้อมูลเพิ่มเติม',
];

const spellSamples = [
  'ผมกีนข้าวกับปลา',
  'กีนข้าว',
  'ประเทส',
  'สวัสดื',
  'กรุงเทบ',
];

const keywordSamples = [
  'นักวิทยาศาสตร์ค้นพบดาวเคราะห์ใหม่ในระบบสุริยะ ดาวดวงนี้โคจรอยู่ใกล้ดาวเคราะห์น้อย ทีมนักวิจัยกำลังศึกษาข้อมูลเพิ่มเติมเกี่ยวกับดาวดวงนี้',
  'อาหารไทยมีชื่อเสียงไปทั่วโลก ต้มยำกุ้งและผัดไทยเป็นอาหารที่คนต่างชาติชื่นชอบ รสชาติเผ็ดและหอมของสมุนไพรไทยทำให้อาหารไทยแตกต่างจากอาหารชาติอื่น',
];

const romanizeSamples = [
  'กินข้าวกับปลา',
  'กรุงเทพมหานครเป็นเมืองหลวงของประเทศไทย',
  'นักวิทยาศาสตร์ค้นพบดาวเคราะห์ใหม่',
];
---

<div class="live-demo-root font-sans" data-compact={compact.toString()}>
  <!-- Input -->
  <div class="mb-4">
    <label for="demo-input" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
      Thai text
    </label>
    <textarea
      id="demo-input"
      rows={compact ? 2 : 3}
      placeholder="พิมพ์ข้อความภาษาไทย…"
      aria-label="Thai text input"
      class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-4 py-3 text-base font-sans focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none placeholder:text-slate-400"
    >{samples[0]}</textarea>

    <!-- Sentence mode hint — shown below textarea only when mode = sentences -->
    {!compact && (
      <div id="demo-input-hint" class="hidden mt-2 flex items-start gap-2 text-xs text-slate-500 dark:text-slate-400">
        <svg class="w-3.5 h-3.5 mt-0.5 shrink-0 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>
          Each sentence ends at a <strong class="text-slate-600 dark:text-slate-300">new line</strong>,
          <strong class="text-slate-600 dark:text-slate-300">! ?</strong>,
          <strong class="text-slate-600 dark:text-slate-300">.</strong> followed by a space, or Thai markers
          <strong class="text-slate-600 dark:text-slate-300 font-mono">ฯ ๚ ๛</strong>.
          Thai text with no markers will appear as a single sentence.
        </span>
      </div>
    )}
  </div>

  <!-- Samples -->
  <div id="demo-samples-row" class="flex flex-wrap gap-2 mb-4" role="group" aria-label="Sample texts">
    <span class="text-xs text-slate-500 self-center">Samples:</span>
    {samples.map((s) => (
      <button
        type="button"
        class="demo-sample text-xs px-3 py-1.5 rounded-md bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 transition-colors truncate max-w-[180px]"
        data-text={s}
        data-mode="seg"
        title={s}
        aria-label={`Use sample: ${s}`}
      >
        {s.length > 14 ? s.slice(0, 14) + '…' : s}
      </button>
    ))}
    {!compact && sentenceSamples.map((s) => (
      <button
        type="button"
        class="demo-sample hidden text-xs px-3 py-1.5 rounded-md bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 transition-colors truncate max-w-[200px]"
        data-text={s}
        data-mode="sentences"
        title={s}
        aria-label={`Use sentence sample`}
      >
        {s.length > 18 ? s.slice(0, 18) + '…' : s}
      </button>
    ))}
    {!compact && spellSamples.map((s) => (
      <button
        type="button"
        class="demo-sample hidden text-xs px-3 py-1.5 rounded-md bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 transition-colors truncate max-w-[160px]"
        data-text={s}
        data-mode="spell"
        title={s}
        aria-label={`Use spell sample: ${s}`}
      >
        {s}
      </button>
    ))}
    {!compact && keywordSamples.map((s) => (
      <button
        type="button"
        class="demo-sample hidden text-xs px-3 py-1.5 rounded-md bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 transition-colors truncate max-w-[200px]"
        data-text={s}
        data-mode="keywords"
        title={s}
        aria-label={`Use keyword sample`}
      >
        {s.length > 18 ? s.slice(0, 18) + '…' : s}
      </button>
    ))}
    {!compact && romanizeSamples.map((s) => (
      <button
        type="button"
        class="demo-sample hidden text-xs px-3 py-1.5 rounded-md bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 transition-colors truncate max-w-[180px]"
        data-text={s}
        data-mode="romanize"
        title={s}
        aria-label={`Use romanize sample: ${s}`}
      >
        {s.length > 14 ? s.slice(0, 14) + '…' : s}
      </button>
    ))}
  </div>

  <!-- Controls row -->
  <div class="flex flex-wrap items-center gap-3 mb-4">
    <button
      id="demo-run"
      type="button"
      aria-label="Run analysis"
      aria-busy="false"
      class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors shadow-sm disabled:opacity-60 disabled:cursor-not-allowed"
    >
      <svg id="demo-spinner" class="hidden animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
      </svg>
      <span id="demo-btn-label">Segment</span>
    </button>

    {!compact && (
      <!-- 5-way mode toggle: Segment | FTS | Sentences | Spell | Keywords -->
      <div class="inline-flex items-center bg-slate-100 dark:bg-slate-800 rounded-lg p-1 gap-0.5" role="group" aria-label="Analysis mode">
        <button type="button" class="demo-mode-tab text-xs font-medium px-3 py-1.5 rounded-md transition-colors" data-mode="seg"       aria-pressed="true">Segment</button>
        <button type="button" class="demo-mode-tab text-xs font-medium px-3 py-1.5 rounded-md transition-colors" data-mode="fts"       aria-pressed="false">FTS</button>
        <button type="button" class="demo-mode-tab text-xs font-medium px-3 py-1.5 rounded-md transition-colors" data-mode="sentences" aria-pressed="false">Sentences</button>
        <button type="button" class="demo-mode-tab text-xs font-medium px-3 py-1.5 rounded-md transition-colors" data-mode="spell"     aria-pressed="false">Spell</button>
        <button type="button" class="demo-mode-tab text-xs font-medium px-3 py-1.5 rounded-md transition-colors" data-mode="keywords"  aria-pressed="false">Keywords</button>
        <button type="button" class="demo-mode-tab text-xs font-medium px-3 py-1.5 rounded-md transition-colors" data-mode="romanize"  aria-pressed="false">Romanize</button>
      </div>
    )}

    <span id="demo-status" class="text-sm text-slate-500 hidden" role="status" aria-live="polite"></span>
  </div>

  <!-- Results -->
  <div id="demo-results" class="hidden" aria-live="polite" aria-label="Analysis results">

    {!compact && (
      <!-- Toolbar -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <!-- Left: count + time -->
        <div class="flex items-center gap-3">
          <p id="demo-count" class="text-xs font-medium text-slate-600 dark:text-slate-400" aria-live="polite"></p>
          <span id="demo-time" class="inline-flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400 font-mono bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 rounded-full px-2 py-0.5 hidden" aria-live="polite">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span id="demo-time-val"></span>
          </span>
        </div>

        <!-- Right: filter + roman toggle + format + copy -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- Kind filter (hidden in sentences mode) -->
          <div id="demo-filter-row" class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by token kind">
            {['All','Thai','Latin','Number','Punctuation','Emoji'].map(k => (
              <button type="button" class="demo-filter text-xs px-2.5 py-1 rounded-full border transition-colors" data-kind={k}>{k}</button>
            ))}
          </div>

          <!-- Roman toggle — only shown in FTS mode -->
          <button
            id="demo-roman-toggle"
            type="button"
            aria-pressed="false"
            class="hidden text-xs px-2.5 py-1 rounded-full border transition-colors border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-400 hover:border-indigo-400 hover:text-indigo-600"
          >
            Roman
          </button>

          <div class="w-px h-5 bg-slate-200 dark:bg-slate-700 hidden sm:block"></div>
          <select id="demo-format" aria-label="Output format" class="text-xs rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="pipe">Pipe  กิน|ข้าว</option>
            <option value="json">JSON  ["กิน","ข้าว"]</option>
            <option value="lines">Lines  one per line</option>
            <option value="space">Space  กิน ข้าว</option>
          </select>
          <button id="demo-copy" type="button" aria-label="Copy output" class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span id="demo-copy-label">Copy</span>
          </button>
        </div>
      </div>
    )}

    <!-- Token pills / sentence cards -->
    <div id="demo-pills" class="flex flex-wrap gap-2 mb-4 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700 min-h-[52px]" role="list" aria-label="Results"></div>

    {!compact && (
      <div id="demo-stats" class="flex flex-wrap gap-3 mb-4 text-xs text-slate-500 dark:text-slate-400"></div>
    )}

    <!-- Sentence mode hint (only visible in sentences mode) -->
    {!compact && (
      <p id="demo-sent-hint" class="hidden text-xs text-slate-400 dark:text-slate-500 mb-4">
        Splits on: newline &nbsp;·&nbsp; <code class="font-mono">! ? .</code> &nbsp;·&nbsp; Thai markers <code class="font-mono">ฯ ๚ ๛</code> &nbsp;·&nbsp; Plain Thai prose without punctuation stays as one sentence.
      </p>
    )}

    <!-- Token table (hidden in sentences mode and compact mode) -->
    {!compact && (
      <div id="demo-table-wrap" class="overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700">
        <table class="w-full text-sm text-left" aria-label="Token details">
          <thead id="demo-thead" class="bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700"></thead>
          <tbody id="demo-tbody" class="divide-y divide-slate-100 dark:divide-slate-700"></tbody>
        </table>
      </div>
    )}

    <!-- compact count/time -->
    {compact && (
      <div class="flex items-center gap-3 mt-3">
        <p id="demo-count" class="text-xs text-slate-400" aria-live="polite"></p>
        <p id="demo-time" class="text-xs text-slate-400" aria-live="polite"></p>
      </div>
    )}
  </div>
</div>

<script is:inline>
(function () {
  // ── colour maps ───────────────────────────────────────────────────────────
  const KIND_COLORS = {
    Thai:        { pill: 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300',          dot: 'bg-blue-400' },
    Latin:       { pill: 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300',      dot: 'bg-green-400' },
    Number:      { pill: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300',  dot: 'bg-yellow-400' },
    Punctuation: { pill: 'bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300',         dot: 'bg-slate-400' },
    Emoji:       { pill: 'bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300',  dot: 'bg-purple-400' },
    Whitespace:  { pill: 'bg-slate-100 text-slate-500',                                               dot: 'bg-slate-300' },
    Unknown:     { pill: 'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300',              dot: 'bg-red-400' },
  };
  const NE_COLORS = {
    Person: { pill: 'bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300', badge: 'bg-purple-200 text-purple-700 dark:bg-purple-800/60 dark:text-purple-300', dot: 'bg-purple-400' },
    Place:  { pill: 'bg-teal-100 text-teal-800 dark:bg-teal-900/40 dark:text-teal-300',         badge: 'bg-teal-200 text-teal-700 dark:bg-teal-800/60 dark:text-teal-300',         dot: 'bg-teal-400' },
    Org:    { pill: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',     badge: 'bg-amber-200 text-amber-700 dark:bg-amber-800/60 dark:text-amber-300',     dot: 'bg-amber-400' },
  };
  const POS_COLORS = {
    Noun: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
    Verb: 'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300',
    Adj:  'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/40 dark:text-yellow-300',
    Adv:  'bg-yellow-100 text-yellow-600 dark:bg-yellow-900/30 dark:text-yellow-400',
    ProperNoun:  'bg-blue-100 text-blue-900 dark:bg-blue-900/50 dark:text-blue-200',
    Pronoun:     'bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300',
    Numeral:     'bg-orange-100 text-orange-700 dark:bg-orange-900/40 dark:text-orange-300',
    Classifier:  'bg-orange-100 text-orange-600 dark:bg-orange-900/30 dark:text-orange-400',
    Particle:    'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400',
    Conjunction: 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400',
    Auxiliary:   'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400',
    Determiner:  'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400',
    Preposition: 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400',
  };
  const SENT_COLORS = [
    'bg-blue-50 border-blue-200 dark:bg-blue-950/30 dark:border-blue-800',
    'bg-violet-50 border-violet-200 dark:bg-violet-950/30 dark:border-violet-800',
    'bg-teal-50 border-teal-200 dark:bg-teal-950/30 dark:border-teal-800',
    'bg-amber-50 border-amber-200 dark:bg-amber-950/30 dark:border-amber-800',
    'bg-rose-50 border-rose-200 dark:bg-rose-950/30 dark:border-rose-800',
  ];
  const SENT_NUM_COLORS = [
    'bg-blue-600',
    'bg-violet-600',
    'bg-teal-600',
    'bg-amber-500',
    'bg-rose-500',
  ];

  // ── state ─────────────────────────────────────────────────────────────────
  let wasmMod      = null;
  let lastTokens   = [];
  let activeFilter = 'All';
  let mode         = 'seg';   // 'seg' | 'fts' | 'sentences' | 'spell' | 'keywords' | 'romanize'
  let showRoman    = false;

  // ── wasm ──────────────────────────────────────────────────────────────────
  async function loadWasm() {
    if (wasmMod) return wasmMod;
    const mod = await import('/wasm/kham_wasm.js');
    await mod.default();
    wasmMod = mod;
    return wasmMod;
  }

  // ── badge helpers ─────────────────────────────────────────────────────────
  function kindBadge(kind) {
    const c = KIND_COLORS[kind];
    const cls = c ? c.pill : 'bg-slate-100 text-slate-700';
    return `<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${cls}">${kind}</span>`;
  }
  function posBadge(pos) {
    if (!pos) return '<span class="text-slate-300 dark:text-slate-600">—</span>';
    const cls = POS_COLORS[pos] || 'bg-slate-100 text-slate-600';
    return `<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${cls}">${pos}</span>`;
  }
  function neBadge(ne) {
    if (!ne) return '<span class="text-slate-300 dark:text-slate-600">—</span>';
    const c = NE_COLORS[ne];
    const cls = c ? c.badge : 'bg-slate-100 text-slate-600';
    return `<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${cls}">${ne}</span>`;
  }
  function romanCell(roman, text) {
    if (!roman || roman === text) return '<span class="text-slate-300 dark:text-slate-600">—</span>';
    return `<span class="font-mono text-xs text-indigo-600 dark:text-indigo-400">${roman}</span>`;
  }

  // ── filter / format ───────────────────────────────────────────────────────
  function visibleTokens() {
    if (activeFilter === 'All') return lastTokens;
    return lastTokens.filter(t => t.kind === activeFilter);
  }
  function formatOutput(tokens) {
    const fmt = document.getElementById('demo-format');
    const format = fmt ? fmt.value : 'pipe';
    const words = tokens.filter(t => t.kind !== 'Whitespace').map(t => t.text);
    if (format === 'json')  return JSON.stringify(words);
    if (format === 'lines') return words.join('\n');
    if (format === 'space') return words.join(' ');
    return words.join('|');
  }

  // ── table builders ────────────────────────────────────────────────────────
  function buildTableHeader() {
    if (mode === 'fts') {
      const romanCol = showRoman
        ? '<th scope="col" class="px-4 py-3 font-semibold text-indigo-500 dark:text-indigo-400">Roman</th>'
        : '';
      return `<tr>
        <th scope="col" class="px-4 py-3 font-semibold text-slate-600 dark:text-slate-400 w-10">#</th>
        <th scope="col" class="px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">Text</th>
        ${romanCol}
        <th scope="col" class="px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">Kind</th>
        <th scope="col" class="px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">POS</th>
        <th scope="col" class="px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">NE</th>
        <th scope="col" class="px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">Stop</th>
        <th scope="col" class="px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">Synonyms</th>
      </tr>`;
    }
    return `<tr>
      <th scope="col" class="px-4 py-3 font-semibold text-slate-600 dark:text-slate-400 w-10">#</th>
      <th scope="col" class="px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">Text</th>
      <th scope="col" class="px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">Kind</th>
      <th scope="col" class="px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">Chars</th>
      <th scope="col" class="px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">Bytes</th>
    </tr>`;
  }

  function buildTableRow(t, i) {
    const base = 'hover:bg-slate-50 dark:hover:bg-slate-800/40';
    if (mode === 'fts') {
      const stopCls = t.is_stop ? 'opacity-50' : '';
      const syns = Array.isArray(t.synonyms) ? t.synonyms : [];
      const synHtml = syns.length
        ? syns.map(s => `<span class="inline-block bg-slate-100 dark:bg-slate-700 rounded px-1 font-mono text-xs">${s}</span>`).join(' ')
        : '<span class="text-slate-300 dark:text-slate-600">—</span>';
      const romanCol = showRoman
        ? `<td class="px-4 py-2.5">${romanCell(t.roman, t.text)}</td>`
        : '';
      return `<tr class="${base} ${stopCls}">
        <td class="px-4 py-2.5 text-slate-400 font-mono text-xs">${i + 1}</td>
        <td class="px-4 py-2.5 font-medium text-slate-900 dark:text-slate-100">${t.text}</td>
        ${romanCol}
        <td class="px-4 py-2.5">${kindBadge(t.kind)}</td>
        <td class="px-4 py-2.5">${posBadge(t.pos)}</td>
        <td class="px-4 py-2.5">${neBadge(t.ne)}</td>
        <td class="px-4 py-2.5 text-center">${t.is_stop
          ? '<span class="text-xs text-slate-400 dark:text-slate-500">stop</span>'
          : '<span class="text-slate-300 dark:text-slate-600">—</span>'}</td>
        <td class="px-4 py-2.5">${synHtml}</td>
      </tr>`;
    }
    return `<tr class="${base}">
      <td class="px-4 py-2.5 text-slate-400 font-mono text-xs">${i + 1}</td>
      <td class="px-4 py-2.5 font-medium text-slate-900 dark:text-slate-100">${t.text}</td>
      <td class="px-4 py-2.5">${kindBadge(t.kind)}</td>
      <td class="px-4 py-2.5 font-mono text-xs text-slate-500">${t.char_start}–${t.char_end}</td>
      <td class="px-4 py-2.5 font-mono text-xs text-slate-500">${t.byte_start}–${t.byte_end}</td>
    </tr>`;
  }

  // ── render spell suggestions + corrected text ────────────────────────────
  function renderSpellResults(suggestions, inputText, corrected) {
    const pills     = document.getElementById('demo-pills');
    const tableWrap = document.getElementById('demo-table-wrap');
    const filterRow = document.getElementById('demo-filter-row');
    const sentHint  = document.getElementById('demo-sent-hint');

    if (tableWrap) tableWrap.classList.add('hidden');
    if (filterRow) filterRow.classList.add('hidden');
    if (sentHint)  sentHint.classList.add('hidden');

    pills.className = 'flex flex-col gap-3 mb-4 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700 min-h-[52px]';
    pills.setAttribute('role', 'region');
    pills.setAttribute('aria-label', 'Spell check results');

    const parts = [];

    // Corrected text banner — shown when spell_correct_text changed the input
    const changed = corrected && corrected !== inputText;
    const correctedBanner = changed
      ? `<div class="flex items-start gap-2.5 p-3 rounded-lg bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800">
          <svg class="w-4 h-4 mt-0.5 shrink-0 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-emerald-700 dark:text-emerald-400 mb-1">Corrected text</p>
            <p class="text-sm text-emerald-900 dark:text-emerald-200 font-medium break-words">${corrected}</p>
          </div>
        </div>`
      : `<div class="flex items-center gap-2 p-2.5 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
          <svg class="w-4 h-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-sm text-slate-500 dark:text-slate-400">No corrections needed.</p>
        </div>`;
    parts.push(correctedBanner);

    // Suggestions list (for single-word input or first unknown token)
    if (suggestions.length) {
      const suggHtml = suggestions.map((s, i) => {
        const editColor = s.edit_distance === 0
          ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300'
          : s.edit_distance === 1
            ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300'
            : 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300';
        const soundexBadge = s.soundex_match
          ? '<span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300">soundex ✓</span>'
          : '';
        return `<div class="flex items-center gap-3 p-2.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-blue-300 dark:hover:border-blue-600 transition-colors" role="listitem">
          <span class="flex-none w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-500 text-xs font-bold flex items-center justify-center">${i + 1}</span>
          <span class="text-base font-semibold text-slate-900 dark:text-slate-100 flex-1">${s.word}</span>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${editColor}">edit ${s.edit_distance}</span>
          ${soundexBadge}
          <span class="text-xs text-slate-400 dark:text-slate-500 font-mono">freq ${s.freq_score}</span>
        </div>`;
      }).join('');
      parts.push(`<div class="flex flex-col gap-1.5" role="list" aria-label="Suggestions">
        <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide px-0.5">Suggestions for "${inputText.split(/\s/)[0]}"</p>
        ${suggHtml}
      </div>`);
    }

    pills.innerHTML = parts.join('');
  }

  // ── render romanization result ────────────────────────────────────────────
  function renderRomanizeResult(romanized) {
    const pills     = document.getElementById('demo-pills');
    const tableWrap = document.getElementById('demo-table-wrap');
    const filterRow = document.getElementById('demo-filter-row');
    const sentHint  = document.getElementById('demo-sent-hint');

    if (tableWrap) tableWrap.classList.add('hidden');
    if (filterRow) filterRow.classList.add('hidden');
    if (sentHint)  sentHint.classList.add('hidden');

    pills.className = 'flex flex-col gap-2 mb-4 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700 min-h-[52px]';
    pills.setAttribute('role', 'region');
    pills.setAttribute('aria-label', 'Romanized text');

    pills.innerHTML = romanized
      ? `<p class="text-base font-mono text-indigo-700 dark:text-indigo-300 leading-relaxed break-words">${romanized}</p>`
      : '<p class="text-sm text-slate-400 dark:text-slate-500 py-2">No output.</p>';
  }

  // ── keyword pill builder (shared by keywords and phrases) ────────────────
  function keywordPillsHtml(items, colorClass) {
    if (!items.length) return '<p class="text-sm text-slate-400 dark:text-slate-500 py-1">None extracted.</p>';
    const maxScore = items[0].score || 1;
    return items.map((k, i) => {
      const pct = Math.round((k.score / maxScore) * 100);
      const intensity = colorClass
        ? (pct > 70 ? colorClass.hi : pct > 40 ? colorClass.mid : colorClass.lo)
        : (pct > 70
            ? 'bg-blue-600 text-white dark:bg-blue-500'
            : pct > 40
              ? 'bg-blue-200 text-blue-800 dark:bg-blue-800/60 dark:text-blue-200'
              : 'bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-300');
      const sizeClass = i === 0 ? 'text-base px-4 py-2' : i < 3 ? 'text-sm px-3 py-1.5' : 'text-xs px-2.5 py-1';
      return `<span class="inline-flex flex-col items-center gap-0.5 rounded-lg font-medium transition-colors ${intensity} ${sizeClass}" role="listitem" title="score ${k.score.toFixed(4)}, count ${k.count}">
        <span>${k.word}</span>
        <span class="text-[10px] opacity-70">×${k.count}</span>
      </span>`;
    }).join('');
  }

  // ── render keyword extraction ─────────────────────────────────────────────
  function renderKeywordResults(keywords, phrases) {
    const pills     = document.getElementById('demo-pills');
    const tableWrap = document.getElementById('demo-table-wrap');
    const filterRow = document.getElementById('demo-filter-row');
    const sentHint  = document.getElementById('demo-sent-hint');

    if (tableWrap) tableWrap.classList.add('hidden');
    if (filterRow) filterRow.classList.add('hidden');
    if (sentHint)  sentHint.classList.add('hidden');

    pills.className = 'flex flex-col gap-4 mb-4 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700 min-h-[52px]';
    pills.setAttribute('role', 'region');
    pills.setAttribute('aria-label', 'Keywords and keyphrases');

    const kwColors = {
      hi:  'bg-blue-600 text-white dark:bg-blue-500',
      mid: 'bg-blue-200 text-blue-800 dark:bg-blue-800/60 dark:text-blue-200',
      lo:  'bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-300',
    };
    const phColors = {
      hi:  'bg-violet-600 text-white dark:bg-violet-500',
      mid: 'bg-violet-200 text-violet-800 dark:bg-violet-800/60 dark:text-violet-200',
      lo:  'bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-300',
    };

    pills.innerHTML = `
      <div>
        <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">Keywords</p>
        <div class="flex flex-wrap gap-2" role="list" aria-label="Keywords">
          ${keywords.length ? keywordPillsHtml(keywords, kwColors) : '<p class="text-sm text-slate-400 dark:text-slate-500 py-1">No keywords extracted.</p>'}
        </div>
      </div>
      <div class="border-t border-slate-200 dark:border-slate-700 pt-3">
        <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">Keyphrases</p>
        <div class="flex flex-wrap gap-2" role="list" aria-label="Keyphrases">
          ${keywordPillsHtml(phrases || [], phColors)}
        </div>
      </div>`;
  }

  // ── render token pills + table ────────────────────────────────────────────
  function renderPillsAndTable(tokens) {
    const pills = document.getElementById('demo-pills');
    const thead = document.getElementById('demo-thead');
    const tbody = document.getElementById('demo-tbody');

    // Reset pills to inline-flex for token mode
    pills.className = 'flex flex-wrap gap-2 mb-4 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700 min-h-[52px]';

    if (mode === 'fts') {
      pills.innerHTML = tokens.map(t => {
        const stopCls = t.is_stop ? 'opacity-40 line-through' : '';
        const pillCls = (t.ne && NE_COLORS[t.ne])
          ? NE_COLORS[t.ne].pill
          : (KIND_COLORS[t.kind] ? KIND_COLORS[t.kind].pill : 'bg-slate-100 text-slate-700');
        const sub = [];
        if (t.pos && !t.is_stop) sub.push(`<span class="text-[10px] leading-tight opacity-60">${t.pos}</span>`);
        if (showRoman && t.roman && t.roman !== t.text) sub.push(`<span class="text-[10px] leading-tight font-mono text-indigo-500 dark:text-indigo-400 opacity-80">${t.roman}</span>`);
        const subHtml = sub.length ? `<span class="flex flex-col items-center gap-0">${sub.join('')}</span>` : '';
        return `<span class="inline-flex flex-col items-center px-3 py-1 rounded-lg text-sm font-medium ${pillCls} ${stopCls}" role="listitem">
          <span>${t.text}</span>${subHtml}
        </span>`;
      }).join('');
    } else {
      pills.innerHTML = tokens.map(t => {
        const c = KIND_COLORS[t.kind];
        const cls = c ? c.pill : 'bg-slate-100 text-slate-700';
        return `<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${cls}" role="listitem">${t.text}</span>`;
      }).join('');
    }

    if (thead) thead.innerHTML = buildTableHeader();
    if (tbody) tbody.innerHTML = tokens.map((t, i) => buildTableRow(t, i)).join('');
  }

  // ── render sentence cards ─────────────────────────────────────────────────
  function renderSentenceCards(sentences) {
    const pills     = document.getElementById('demo-pills');
    const tableWrap = document.getElementById('demo-table-wrap');
    const filterRow = document.getElementById('demo-filter-row');

    // Switch pills to vertical card list
    pills.className = 'flex flex-col gap-3 mb-4 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700 min-h-[52px]';
    pills.setAttribute('role', 'list');
    pills.setAttribute('aria-label', 'Sentences');

    pills.innerHTML = sentences.length
      ? sentences.map((s, i) => {
          const color    = SENT_COLORS[i % SENT_COLORS.length];
          const numColor = SENT_NUM_COLORS[i % SENT_NUM_COLORS.length];
          return `<div class="flex items-start gap-3 p-3 rounded-lg border ${color}" role="listitem">
            <span class="flex-shrink-0 w-6 h-6 rounded-full ${numColor} text-white text-xs font-bold flex items-center justify-center mt-0.5">${i + 1}</span>
            <div class="flex-1 min-w-0">
              <p class="text-sm text-slate-900 dark:text-slate-100 leading-relaxed">${s.text}</p>
              <span class="text-xs text-slate-400 dark:text-slate-500 font-mono">chars ${s.char_start}–${s.char_end}</span>
            </div>
          </div>`;
        }).join('')
      : '<p class="text-sm text-slate-400 dark:text-slate-500 py-2">No sentences detected.</p>';

    // Hide token table and kind filters; show hint in sentences mode
    if (tableWrap) tableWrap.classList.add('hidden');
    if (filterRow) filterRow.classList.add('hidden');
    const sentHint = document.getElementById('demo-sent-hint');
    if (sentHint) sentHint.classList.remove('hidden');
  }

  // ── render stats ──────────────────────────────────────────────────────────
  function renderStats(tokens) {
    const stats = document.getElementById('demo-stats');
    if (!stats) return;
    const counts = {};
    tokens.forEach(t => { counts[t.kind] = (counts[t.kind] || 0) + 1; });

    if (mode === 'fts') {
      const stopCount = tokens.filter(t => t.is_stop).length;
      const neCount   = tokens.filter(t => t.ne).length;
      const posCount  = tokens.filter(t => t.pos).length;
      const extra = [
        stopCount ? `<span>Stopwords: <strong>${stopCount}</strong></span>` : null,
        neCount   ? `<span>Named entities: <strong>${neCount}</strong></span>` : null,
        posCount  ? `<span>POS-tagged: <strong>${posCount}</strong></span>` : null,
      ].filter(Boolean).join('');
      stats.innerHTML = Object.entries(counts).sort((a,b) => b[1]-a[1]).map(([kind, n]) => {
        const c = NE_COLORS[kind] || KIND_COLORS[kind];
        const dot = c ? c.dot : 'bg-slate-400';
        return `<span class="inline-flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-full ${dot}"></span><span>${kind}: <strong>${n}</strong></span></span>`;
      }).join('') + (extra ? `<span class="w-px h-4 bg-slate-200 dark:bg-slate-700 mx-1 self-center"></span>${extra}` : '');
    } else {
      stats.innerHTML = Object.entries(counts).sort((a,b) => b[1]-a[1]).map(([kind, n]) => {
        const c = KIND_COLORS[kind];
        const dot = c ? c.dot : 'bg-slate-400';
        return `<span class="inline-flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-full ${dot}"></span><span>${kind}: <strong>${n}</strong></span></span>`;
      }).join('');
    }
  }

  // ── UI state sync ─────────────────────────────────────────────────────────
  function updateModeButtons() {
    document.querySelectorAll('.demo-mode-tab').forEach(btn => {
      const active = btn.dataset.mode === mode;
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      btn.className = `demo-mode-tab text-xs font-medium px-3 py-1.5 rounded-md transition-colors ${
        active
          ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 shadow-sm'
          : 'text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300'
      }`;
    });

    // Show/hide elements based on mode
    const romanBtn   = document.getElementById('demo-roman-toggle');
    const filterRow  = document.getElementById('demo-filter-row');
    const tableWrap  = document.getElementById('demo-table-wrap');
    const sentHint   = document.getElementById('demo-sent-hint');
    const inputHint  = document.getElementById('demo-input-hint');
    const tokenOnlyMode = mode === 'sentences' || mode === 'spell' || mode === 'keywords' || mode === 'romanize';
    if (romanBtn)  romanBtn.classList.toggle('hidden', mode !== 'fts');
    if (filterRow) filterRow.classList.toggle('hidden', tokenOnlyMode);
    if (tableWrap) tableWrap.classList.toggle('hidden', tokenOnlyMode);
    if (sentHint)  sentHint.classList.toggle('hidden', mode !== 'sentences');
    if (inputHint) inputHint.classList.toggle('hidden', mode !== 'sentences');

    // Swap sample buttons — each mode shows only its own samples
    document.querySelectorAll('.demo-sample').forEach(btn => {
      const btnMode = btn.dataset.mode || 'seg';
      // seg samples show for seg and fts
      if (btnMode === 'seg') {
        btn.classList.toggle('hidden', mode !== 'seg' && mode !== 'fts');
      } else {
        btn.classList.toggle('hidden', btnMode !== mode);
      }
    });

    // Update run button label
    const labelMap = { sentences: 'Split', spell: 'Check', keywords: 'Extract', romanize: 'Romanize' };
    const label = document.getElementById('demo-btn-label');
    if (label) label.textContent = labelMap[mode] || 'Segment';
  }

  function updateFilterButtons() {
    document.querySelectorAll('.demo-filter').forEach(btn => {
      const active = btn.dataset.kind === activeFilter;
      btn.className = `demo-filter text-xs px-2.5 py-1 rounded-full border transition-colors ${
        active
          ? 'bg-blue-600 border-blue-600 text-white'
          : 'border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-400 hover:border-blue-400 hover:text-blue-600'
      }`;
    });
  }

  function updateRomanToggle() {
    const btn = document.getElementById('demo-roman-toggle');
    if (!btn) return;
    btn.setAttribute('aria-pressed', showRoman ? 'true' : 'false');
    btn.className = `text-xs px-2.5 py-1 rounded-full border transition-colors ${
      showRoman
        ? 'bg-indigo-600 border-indigo-600 text-white'
        : 'border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-400 hover:border-indigo-400 hover:text-indigo-600'
    }`;
    if (mode !== 'fts') btn.classList.add('hidden');
    else btn.classList.remove('hidden');
  }

  // ── loading state ─────────────────────────────────────────────────────────
  function setLoading(loading) {
    const btn     = document.getElementById('demo-run');
    const spinner = document.getElementById('demo-spinner');
    const label   = document.getElementById('demo-btn-label');
    const status  = document.getElementById('demo-status');
    btn.disabled = loading;
    btn.setAttribute('aria-busy', loading ? 'true' : 'false');
    spinner.classList.toggle('hidden', !loading);
    const labelMap = { sentences: 'Split', spell: 'Check', keywords: 'Extract', romanize: 'Romanize' };
    label.textContent = loading ? 'Loading…' : (labelMap[mode] || 'Segment');
    if (status) { status.classList.toggle('hidden', !loading); status.textContent = loading ? 'Initialising WebAssembly…' : ''; }
  }

  // ── run handlers ──────────────────────────────────────────────────────────
  async function runTokens() {
    const text = document.getElementById('demo-input').value.trim();
    if (!text) return;
    setLoading(true);
    try {
      const mod = await loadWasm();
      const t0 = performance.now();
      const tokens = mode === 'fts' ? mod.segment_fts(text) : mod.segment_tokens(text);
      const elapsed = performance.now() - t0;
      lastTokens = tokens;

      const tableWrap = document.getElementById('demo-table-wrap');
      const filterRow = document.getElementById('demo-filter-row');
      if (tableWrap) tableWrap.classList.remove('hidden');
      if (filterRow) filterRow.classList.remove('hidden');

      renderPillsAndTable(visibleTokens());
      renderStats(tokens);
      updateFilterButtons();

      const count = document.getElementById('demo-count');
      if (count) count.textContent = `${tokens.length} token${tokens.length !== 1 ? 's' : ''}`;

      const timeBadge = document.getElementById('demo-time');
      const timeVal   = document.getElementById('demo-time-val');
      const timeStr   = elapsed < 1 ? `${(elapsed * 1000).toFixed(0)} µs` : `${elapsed.toFixed(2)} ms`;
      if (timeVal) { timeVal.textContent = timeStr; timeBadge.classList.remove('hidden'); }
      else if (timeBadge) timeBadge.textContent = timeStr;

      document.getElementById('demo-results').classList.remove('hidden');
    } catch (err) {
      console.error('kham-wasm error:', err);
      const status = document.getElementById('demo-status');
      if (status) { status.classList.remove('hidden'); status.textContent = 'Error loading WebAssembly. Check console.'; }
    } finally {
      setLoading(false);
    }
  }

  async function runSentences() {
    const text = document.getElementById('demo-input').value.trim();
    if (!text) return;
    setLoading(true);
    try {
      const mod = await loadWasm();
      const t0 = performance.now();
      const sentences = mod.split_sentences(text);
      const elapsed = performance.now() - t0;

      renderSentenceCards(sentences);

      const stats = document.getElementById('demo-stats');
      if (stats) {
        const totalChars = sentences.reduce((s, t) => s + t.text.length, 0);
        stats.innerHTML = `<span>Total chars: <strong>${totalChars}</strong></span>`;
      }

      const count = document.getElementById('demo-count');
      if (count) count.textContent = `${sentences.length} sentence${sentences.length !== 1 ? 's' : ''}`;

      const timeBadge = document.getElementById('demo-time');
      const timeVal   = document.getElementById('demo-time-val');
      const timeStr   = elapsed < 1 ? `${(elapsed * 1000).toFixed(0)} µs` : `${elapsed.toFixed(2)} ms`;
      if (timeVal) { timeVal.textContent = timeStr; timeBadge.classList.remove('hidden'); }
      else if (timeBadge) timeBadge.textContent = timeStr;

      document.getElementById('demo-results').classList.remove('hidden');
    } catch (err) {
      console.error('kham-wasm error:', err);
      const status = document.getElementById('demo-status');
      if (status) { status.classList.remove('hidden'); status.textContent = 'Error loading WebAssembly. Check console.'; }
    } finally {
      setLoading(false);
    }
  }

  async function runSpell() {
    const text = document.getElementById('demo-input').value.trim();
    if (!text) return;
    setLoading(true);
    try {
      const mod = await loadWasm();
      const t0 = performance.now();
      // Use the first token of multi-word input for suggestions; correct_text handles full passage
      const firstWord = text.split(/\s+/)[0];
      const suggestions = mod.spell_suggestions(firstWord, 8);
      const corrected   = mod.spell_correct_text(text);
      const elapsed = performance.now() - t0;

      renderSpellResults(suggestions, text, corrected);

      const changed = corrected && corrected !== text;
      const stats = document.getElementById('demo-stats');
      if (stats) stats.innerHTML = changed
        ? `<span>Corrected passage · Suggestions for <strong>${firstWord}</strong>: <strong>${suggestions.length}</strong></span>`
        : suggestions.length
          ? `<span>Input: <strong>${firstWord}</strong></span><span class="w-px h-4 bg-slate-200 dark:bg-slate-700 mx-1 self-center"></span><span>Suggestions: <strong>${suggestions.length}</strong></span>`
          : `<span>No corrections needed for <strong>${text}</strong></span>`;

      const count = document.getElementById('demo-count');
      if (count) count.textContent = changed
        ? `corrected · ${suggestions.length} suggestion${suggestions.length !== 1 ? 's' : ''}`
        : `${suggestions.length} suggestion${suggestions.length !== 1 ? 's' : ''}`;

      const timeBadge = document.getElementById('demo-time');
      const timeVal   = document.getElementById('demo-time-val');
      const timeStr   = elapsed < 1 ? `${(elapsed * 1000).toFixed(0)} µs` : `${elapsed.toFixed(2)} ms`;
      if (timeVal) { timeVal.textContent = timeStr; timeBadge.classList.remove('hidden'); }
      else if (timeBadge) timeBadge.textContent = timeStr;

      document.getElementById('demo-results').classList.remove('hidden');
    } catch (err) {
      console.error('kham-wasm error:', err);
      const status = document.getElementById('demo-status');
      if (status) { status.classList.remove('hidden'); status.textContent = 'Error loading WebAssembly. Check console.'; }
    } finally {
      setLoading(false);
    }
  }

  async function runRomanize() {
    const text = document.getElementById('demo-input').value.trim();
    if (!text) return;
    setLoading(true);
    try {
      const mod = await loadWasm();
      const t0 = performance.now();
      const romanized = mod.romanize_sentence(text);
      const elapsed = performance.now() - t0;

      renderRomanizeResult(romanized);

      const stats = document.getElementById('demo-stats');
      if (stats) stats.innerHTML = `<span>Input: <strong>${text.length}</strong> chars → Romanized: <strong>${romanized.length}</strong> chars</span>`;

      const count = document.getElementById('demo-count');
      if (count) count.textContent = romanized ? '1 result' : 'no output';

      const timeBadge = document.getElementById('demo-time');
      const timeVal   = document.getElementById('demo-time-val');
      const timeStr   = elapsed < 1 ? `${(elapsed * 1000).toFixed(0)} µs` : `${elapsed.toFixed(2)} ms`;
      if (timeVal) { timeVal.textContent = timeStr; timeBadge.classList.remove('hidden'); }
      else if (timeBadge) timeBadge.textContent = timeStr;

      document.getElementById('demo-results').classList.remove('hidden');
    } catch (err) {
      console.error('kham-wasm error:', err);
      const status = document.getElementById('demo-status');
      if (status) { status.classList.remove('hidden'); status.textContent = 'Error loading WebAssembly. Check console.'; }
    } finally {
      setLoading(false);
    }
  }

  async function runKeywords() {
    const text = document.getElementById('demo-input').value.trim();
    if (!text) return;
    setLoading(true);
    try {
      const mod = await loadWasm();
      const t0 = performance.now();
      const keywords = mod.extract_keywords(text, 10);
      const phrases  = mod.extract_phrases(text, 5);
      const elapsed = performance.now() - t0;

      renderKeywordResults(keywords, phrases);

      const stats = document.getElementById('demo-stats');
      if (stats) stats.innerHTML = `<span>Keywords: <strong>${keywords.length}</strong></span><span class="w-px h-4 bg-slate-200 dark:bg-slate-700 mx-1 self-center"></span><span>Keyphrases: <strong>${phrases.length}</strong></span>`;

      const count = document.getElementById('demo-count');
      if (count) count.textContent = `${keywords.length} keyword${keywords.length !== 1 ? 's' : ''} · ${phrases.length} phrase${phrases.length !== 1 ? 's' : ''}`;

      const timeBadge = document.getElementById('demo-time');
      const timeVal   = document.getElementById('demo-time-val');
      const timeStr   = elapsed < 1 ? `${(elapsed * 1000).toFixed(0)} µs` : `${elapsed.toFixed(2)} ms`;
      if (timeVal) { timeVal.textContent = timeStr; timeBadge.classList.remove('hidden'); }
      else if (timeBadge) timeBadge.textContent = timeStr;

      document.getElementById('demo-results').classList.remove('hidden');
    } catch (err) {
      console.error('kham-wasm error:', err);
      const status = document.getElementById('demo-status');
      if (status) { status.classList.remove('hidden'); status.textContent = 'Error loading WebAssembly. Check console.'; }
    } finally {
      setLoading(false);
    }
  }

  function run() {
    if (mode === 'sentences') runSentences();
    else if (mode === 'spell') runSpell();
    else if (mode === 'keywords') runKeywords();
    else if (mode === 'romanize') runRomanize();
    else runTokens();
  }

  // ── event wiring ──────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    updateModeButtons();
    updateFilterButtons();
    updateRomanToggle();

    document.getElementById('demo-run')?.addEventListener('click', run);

    document.querySelectorAll('.demo-sample').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('demo-input').value = btn.dataset.text;
      });
    });

    document.getElementById('demo-input')?.addEventListener('keydown', e => {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); run(); }
    });

    document.querySelectorAll('.demo-mode-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        mode = btn.dataset.mode;
        updateModeButtons();
        updateRomanToggle();

        // Load first sample for this mode into the textarea
        const sampleMode = (mode === 'fts') ? 'seg' : mode;
        const firstSample = document.querySelector(`.demo-sample[data-mode="${sampleMode}"]`);
        if (firstSample) document.getElementById('demo-input').value = firstSample.dataset.text;

        run();
      });
    });

    document.getElementById('demo-roman-toggle')?.addEventListener('click', () => {
      showRoman = !showRoman;
      updateRomanToggle();
      if (lastTokens.length) renderPillsAndTable(visibleTokens());
    });

    document.querySelectorAll('.demo-filter').forEach(btn => {
      btn.addEventListener('click', () => {
        activeFilter = btn.dataset.kind;
        updateFilterButtons();
        if (lastTokens.length) renderPillsAndTable(visibleTokens());
      });
    });

    document.getElementById('demo-format')?.addEventListener('change', () => {
      if (lastTokens.length) renderPillsAndTable(visibleTokens());
    });

    const copyBtn   = document.getElementById('demo-copy');
    const copyLabel = document.getElementById('demo-copy-label');
    copyBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(formatOutput(visibleTokens())).then(() => {
        copyLabel.textContent = 'Copied!';
        setTimeout(() => { copyLabel.textContent = 'Copy'; }, 1500);
      });
    });

    loadWasm().catch(() => {});
  });
})();
</script>
