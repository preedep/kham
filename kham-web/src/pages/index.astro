---
import Layout from '../layouts/Layout.astro';
import BadgeRow from '../components/BadgeRow.astro';
import LiveDemo from '../components/LiveDemo.astro';

const features = [
  {
    icon: '⚡',
    title: 'Fast',
    body: 'Maximal Matching on a compressed DAWG dictionary. Outperforms PyThaiNLP newmm on throughput while matching accuracy.',
  },
  {
    icon: '📦',
    title: 'Multi-target',
    body: 'One core, many targets: Rust crate, WebAssembly, Python (PyO3), C FFI, CLI, PostgreSQL FTS parser, SQLite FTS5 tokenizer.',
  },
  {
    icon: '🔒',
    title: 'no_std core',
    body: 'kham-core is pure Rust with no_std + alloc. Runs in embedded, WASM, and any environment without a standard library.',
  },
  {
    icon: '🌐',
    title: 'Full NLP pipeline',
    body: 'Segmentation, POS tagging, Named Entity Recognition, romanization (RTGS), phonetic codes (lk82 / udom83 / MetaSound), number normalization.',
  },
];

const codeSnippet = `use kham_core::Segmenter;

let seg = Segmenter::new();
let tokens = seg.segment("กินข้าวกับปลา");
// ["กิน", "ข้าว", "กับ", "ปลา"]`;
---

<Layout title="kham — Fast Thai Word Segmentation in Rust">

  <!-- Hero -->
  <section class="bg-gradient-to-br from-slate-900 via-slate-800 to-blue-950 text-white">
    <div class="max-w-4xl mx-auto px-6 py-28 text-center">
      <div class="inline-flex items-center gap-2 bg-blue-500/20 text-blue-300 text-sm font-medium px-4 py-1.5 rounded-full mb-8 border border-blue-500/30">
        <span>v0.5.0</span>
        <span class="opacity-50">·</span>
        <a href="https://github.com/preedep/kham/releases" target="_blank" rel="noopener noreferrer" class="hover:text-blue-200 transition-colors">
          Release notes →
        </a>
      </div>

      <h1 class="text-5xl sm:text-6xl font-bold tracking-tight mb-6 leading-tight">
        Fast Thai Word<br />Segmentation in Rust
      </h1>

      <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed">
        kham is a batteries-included Thai NLP engine — zero external dependencies,
        <code class="bg-slate-700/70 text-blue-300 px-1.5 py-0.5 rounded text-base font-mono">no_std</code> core,
        and ready for Rust, WebAssembly, Python, C, PostgreSQL, and SQLite.
      </p>

      <div class="mb-10">
        <BadgeRow />
      </div>

      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="https://github.com/preedep/kham"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-white text-slate-900 font-semibold px-7 py-3 rounded-lg hover:bg-slate-100 transition-colors shadow-lg"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          GitHub
        </a>
        <a
          href="https://docs.rs/kham-core"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-blue-600 text-white font-semibold px-7 py-3 rounded-lg hover:bg-blue-500 transition-colors shadow-lg"
        >
          Docs
        </a>
        <a
          href="/demo"
          class="inline-flex items-center gap-2 border border-white/40 text-white font-semibold px-7 py-3 rounded-lg hover:bg-white/10 transition-colors"
        >
          Live Demo
        </a>
      </div>
    </div>
  </section>

  <!-- Quick install -->
  <section class="bg-slate-950 text-slate-300">
    <div class="max-w-4xl mx-auto px-6 py-10">
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center font-mono text-sm">
        <div class="flex items-center gap-3 bg-slate-800 rounded-lg px-5 py-3 w-full sm:w-auto">
          <span class="text-slate-500 select-none">#</span>
          <span class="text-green-400">Cargo.toml</span>
          <span class="text-slate-400">kham-core = "0.5"</span>
        </div>
        <div class="flex items-center gap-3 bg-slate-800 rounded-lg px-5 py-3 w-full sm:w-auto">
          <span class="text-slate-500 select-none">$</span>
          <span class="text-blue-400">pip install</span>
          <span class="text-slate-400">kham</span>
        </div>
        <div class="flex items-center gap-3 bg-slate-800 rounded-lg px-5 py-3 w-full sm:w-auto">
          <span class="text-slate-500 select-none">$</span>
          <span class="text-yellow-400">npm install</span>
          <span class="text-slate-400">kham-wasm</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Features grid -->
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center text-slate-900 mb-4">Everything you need for Thai NLP</h2>
      <p class="text-center text-slate-500 mb-16 max-w-xl mx-auto">
        A single library for the full pipeline — from raw text to structured tokens with semantic metadata.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {features.map(({ icon, title, body }) => (
          <div class="p-6 rounded-xl border border-slate-200 hover:border-blue-200 hover:shadow-md transition-all">
            <div class="text-3xl mb-4">{icon}</div>
            <h3 class="font-semibold text-slate-900 mb-2">{title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code snippet -->
  <section class="py-24 bg-slate-50">
    <div class="max-w-4xl mx-auto px-6">
      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="flex-1">
          <h2 class="text-3xl font-bold text-slate-900 mb-4">Simple, zero-copy API</h2>
          <p class="text-slate-600 leading-relaxed mb-6">
            Segment Thai text into tokens with byte and Unicode char spans — suitable for search indexing, NLP pipelines,
            and binding to any language runtime.
          </p>
          <a
            href="/getting-started"
            class="inline-flex items-center gap-2 text-blue-600 font-medium hover:text-blue-800 transition-colors"
          >
            Getting started guide →
          </a>
        </div>
        <div class="flex-1 w-full">
          <div class="bg-slate-900 rounded-xl overflow-hidden shadow-xl">
            <div class="flex items-center gap-2 px-4 py-3 bg-slate-800 border-b border-slate-700">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <span class="ml-2 text-xs text-slate-500 font-mono">main.rs</span>
            </div>
            <pre class="p-6 text-sm font-mono text-slate-300 overflow-x-auto leading-relaxed"><code>{codeSnippet}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Demo teaser -->
  <section class="py-24 bg-white border-t border-slate-100">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-slate-900 mb-3">Try it right now</h2>
        <p class="text-slate-500 max-w-lg mx-auto">
          Powered by WebAssembly — runs entirely in your browser, no server needed.
        </p>
      </div>
      <div class="bg-slate-50 rounded-2xl border border-slate-200 p-6 md:p-8">
        <LiveDemo compact={true} />
      </div>
      <div class="text-center mt-6">
        <a href="/demo" class="text-blue-600 font-medium hover:text-blue-800 transition-colors">
          Open full playground →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-blue-600 text-white text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-3xl font-bold mb-4">Ready to integrate?</h2>
      <p class="text-blue-100 mb-8">
        Add kham to your Rust, Python, or Node.js project in minutes.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/getting-started"
          class="bg-white text-blue-700 font-semibold px-8 py-3 rounded-lg hover:bg-blue-50 transition-colors shadow"
        >
          Get started
        </a>
        <a
          href="/demo"
          class="border border-white/60 text-white font-semibold px-8 py-3 rounded-lg hover:bg-white/10 transition-colors"
        >
          Try the live demo
        </a>
      </div>
    </div>
  </section>

</Layout>
