---
const examples = [
  {
    label: 'Duplicate tone',
    comment: 'Double ้้ collapsed to ้',
    raw: 'ข้้าว',
  },
  {
    label: 'Sara Am compose',
    comment: 'อํ + า → อำ',
    raw: 'กํากับ',
  },
  {
    label: 'Already clean',
    comment: 'No change needed',
    raw: 'กินข้าวกับปลา',
  },
];
---

<div class="normalizer-root font-sans">
  <!-- Header -->
  <div class="mb-5">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Text Normalizer</h2>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
      Collapses duplicate tone marks and composes nikhahit&nbsp;+&nbsp;sara aa into sara am (อำ).
    </p>
  </div>

  <!-- Input + quick examples -->
  <div class="mb-5">
    <label for="norm-input" class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5">Input</label>
    <textarea
      id="norm-input"
      rows="2"
      placeholder="พิมพ์ข้อความภาษาไทย…"
      aria-label="Text to normalize"
      class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3 py-2 text-base font-sans focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none placeholder:text-slate-400"
    ></textarea>

    <div class="flex flex-wrap items-center gap-2 mt-2">
      <span class="text-xs text-slate-500 dark:text-slate-400">Try:</span>
      {examples.map(e => (
        <button
          type="button"
          class="norm-example text-xs px-3 py-1.5 rounded-md bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 transition-colors"
          data-raw={e.raw}
          aria-label={`Try: ${e.label}`}
        >
          {e.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Before / After panels -->
  <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr] items-start gap-3">

    <!-- Before -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide">Before</span>
      </div>
      <div
        id="norm-before"
        class="min-h-[64px] rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 px-4 py-3 text-base leading-relaxed break-all text-slate-400 dark:text-slate-500 italic"
      >
        <span class="select-none">—</span>
      </div>
    </div>

    <!-- Arrow divider -->
    <div class="hidden sm:flex items-center justify-center pt-7">
      <svg class="w-5 h-5 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </div>

    <!-- After -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide">After</span>
        <span id="norm-status" class="text-xs font-medium text-slate-400 dark:text-slate-500"></span>
      </div>
      <div
        id="norm-after"
        aria-live="polite"
        class="min-h-[64px] rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 px-4 py-3 text-base leading-relaxed break-all text-slate-400 dark:text-slate-500 italic"
      >
        <span class="select-none">—</span>
      </div>
    </div>
  </div>

  <!-- Legend — only visible when there are changes -->
  <div id="norm-legend" class="hidden mt-3 flex flex-wrap items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
    <span class="flex items-center gap-1.5">
      <span class="inline-block w-3 h-3 rounded-sm bg-red-100 dark:bg-red-900/40 border border-red-300 dark:border-red-700"></span>
      removed
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block w-3 h-3 rounded-sm bg-emerald-100 dark:bg-emerald-900/40 border border-emerald-300 dark:border-emerald-700"></span>
      composed
    </span>
  </div>
</div>

<script is:inline>
(function () {
  let wasmMod = null;

  async function loadWasm() {
    if (wasmMod) return wasmMod;
    const mod = await import('/wasm/kham_wasm.js');
    await mod.default();
    wasmMod = mod;
    return wasmMod;
  }

  // ---------------------------------------------------------------------------
  // Diff helpers
  // ---------------------------------------------------------------------------

  const TONE_MARKS = new Set([0x0E48, 0x0E49, 0x0E4A, 0x0E4B]);
  const NIKHAHIT   = 0x0E4D;
  const SARA_AA    = 0x0E32;
  const SARA_AM    = 0x0E33;

  function esc(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // Build annotated HTML for the "After" panel.
  // Changed characters get coloured spans; unchanged chars are plain text.
  function buildAfterHtml(input, output) {
    if (input === output) return `<span class="text-slate-800 dark:text-slate-100 not-italic">${esc(output)}</span>`;

    const iChars = [...input];
    const oChars = [...output];
    let html = '';
    let i = 0, o = 0;

    while (i < iChars.length) {
      const ic = iChars[i];
      const oc = oChars[o];

      if (o >= oChars.length) {
        // tail of input was dropped — shouldn't normally reach here, but guard it
        i++;
        continue;
      }

      if (ic === oc) {
        html += esc(ic);
        i++; o++;
        continue;
      }

      // Sara Am composition: nikhahit + sara-aa → sara-am
      if (
        ic.codePointAt(0) === NIKHAHIT &&
        i + 1 < iChars.length &&
        iChars[i + 1].codePointAt(0) === SARA_AA &&
        oc.codePointAt(0) === SARA_AM
      ) {
        html += `<span class="rounded px-0.5 bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-400" title="composed: อํ + า → อำ">${esc(oc)}</span>`;
        i += 2; o++;
        continue;
      }

      // Dropped char (duplicate tone mark etc.) — skip in input, don't emit in output
      i++;
    }

    // emit any remaining output chars (should not happen given normalizer rules)
    while (o < oChars.length) { html += esc(oChars[o++]); }

    return `<span class="text-slate-800 dark:text-slate-100 not-italic">${html}</span>`;
  }

  // Build annotated HTML for the "Before" panel.
  // Chars that were removed/collapsed are highlighted red with strikethrough.
  function buildBeforeHtml(input, output) {
    if (input === output) return `<span class="text-slate-800 dark:text-slate-100 not-italic">${esc(input)}</span>`;

    const iChars = [...input];
    const oChars = [...output];
    let html = '';
    let i = 0, o = 0;

    while (i < iChars.length) {
      const ic = iChars[i];
      const oc = oChars[o];

      if (o >= oChars.length || ic !== oc) {
        // Sara Am composition: mark both nikhahit + sara-aa as removed
        if (
          ic.codePointAt(0) === NIKHAHIT &&
          i + 1 < iChars.length &&
          iChars[i + 1].codePointAt(0) === SARA_AA &&
          oc && oc.codePointAt(0) === SARA_AM
        ) {
          html += `<span class="rounded px-0.5 bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400 line-through text-xs align-middle" title="→ composed into อำ">${esc(ic)}${esc(iChars[i+1])}</span>`;
          i += 2; o++;
          continue;
        }

        // Dropped char
        const cp = ic.codePointAt(0);
        const name = TONE_MARKS.has(cp) ? 'duplicate tone mark' : `U+${cp.toString(16).toUpperCase().padStart(4,'0')}`;
        html += `<span class="rounded px-0.5 bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400 line-through text-xs align-middle" title="removed: ${name}">${esc(ic)}</span>`;
        i++;
        continue;
      }

      html += esc(ic);
      i++; o++;
    }

    return `<span class="text-slate-800 dark:text-slate-100 not-italic">${html}</span>`;
  }

  // ---------------------------------------------------------------------------
  // UI update
  // ---------------------------------------------------------------------------

  async function run() {
    const input    = document.getElementById('norm-input').value;
    const beforeEl = document.getElementById('norm-before');
    const afterEl  = document.getElementById('norm-after');
    const statusEl = document.getElementById('norm-status');
    const legendEl = document.getElementById('norm-legend');

    const empty = '<span class="select-none text-slate-400 dark:text-slate-500 italic">—</span>';

    if (!input) {
      beforeEl.innerHTML = empty;
      afterEl.innerHTML  = empty;
      statusEl.textContent = '';
      legendEl.classList.add('hidden');
      return;
    }

    try {
      const mod    = await loadWasm();
      const output = mod.normalize(input);

      beforeEl.innerHTML = buildBeforeHtml(input, output);
      afterEl.innerHTML  = buildAfterHtml(input, output);

      if (input === output) {
        statusEl.textContent = 'Already normalized ✓';
        statusEl.className   = 'text-xs font-medium text-emerald-600 dark:text-emerald-400';
        legendEl.classList.add('hidden');
      } else {
        const delta = [...input].length - [...output].length;
        statusEl.textContent = delta === 1 ? '1 char removed' : `${delta} chars removed`;
        statusEl.className   = 'text-xs font-medium text-amber-600 dark:text-amber-400';
        legendEl.classList.remove('hidden');
      }
    } catch (err) {
      console.error('kham normalize error:', err);
      beforeEl.innerHTML = empty;
      afterEl.innerHTML  = '<span class="text-red-500">Error — see console</span>';
      statusEl.textContent = '';
      legendEl.classList.add('hidden');
    }
  }

  // ---------------------------------------------------------------------------
  // Boot
  // ---------------------------------------------------------------------------

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('norm-input')?.addEventListener('input', run);

    document.querySelectorAll('.norm-example').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('norm-input').value = btn.dataset.raw;
        run();
      });
    });

    loadWasm().catch(() => {});
  });
})();
</script>
