---
import Layout from '../../layouts/Layout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
---

<Layout
  title="kham CLI — Command-Line Thai NLP Tool"
  description="Full reference for kham-cli: Thai word segmentation, FTS inspection, spell checking, keyword extraction, RTGS romanization, and JSON/CSV output from the command line."
  lang="en"
  keywords="kham CLI, Thai NLP command line, Thai word segmentation CLI, kham-cli, Thai tokenizer shell, Thai spell check CLI, Thai keyword extraction CLI"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://kham.io/' },
        { '@type': 'ListItem', position: 2, name: 'Getting Started', item: 'https://kham.io/getting-started' },
        { '@type': 'ListItem', position: 3, name: 'CLI', item: 'https://kham.io/integrations/cli' },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: 'kham CLI — Full Reference',
      description: 'Complete guide to kham-cli: segmentation, FTS inspection, spell checking, keyword extraction, romanization, and structured output.',
      url: 'https://kham.io/integrations/cli',
      inLanguage: 'en',
      author: { '@type': 'Organization', name: 'kham contributors', url: 'https://github.com/preedep/kham' },
    },
  ]}
>
  <div class="max-w-4xl mx-auto px-6 py-16">

    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 dark:text-slate-400 mb-8" aria-label="Breadcrumb">
      <a href="/getting-started" class="hover:text-slate-800 dark:hover:text-slate-200 transition-colors">Getting Started</a>
      <span class="mx-2">/</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium">CLI</span>
    </nav>

    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-4xl">💻</span>
        <h1 class="text-4xl font-bold text-slate-900 dark:text-slate-100">kham CLI</h1>
      </div>
      <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl">
        A command-line Thai NLP tool — segment text, inspect FTS pipelines, check spelling, extract keywords, and romanize Thai to RTGS Latin, all without writing a single line of code.
      </p>
    </div>

    <!-- Jump links -->
    <nav class="flex flex-wrap gap-2 mb-14" aria-label="Section jump links">
      {[
        ['#install', 'Install'],
        ['#basic', 'Basic segmentation'],
        ['#output-flags', 'Output flags'],
        ['#fts', 'FTS mode'],
        ['#confidence', 'Confidence'],
        ['#spell', 'Spell checking'],
        ['#keywords', 'Keywords'],
        ['#romanize', 'Romanization'],
        ['#formats', 'Output formats'],
        ['#custom-dict', 'Custom dict'],
        ['#stdin', 'Stdin / pipes'],
        ['#reference', 'Flag reference'],
      ].map(([href, label]) => (
        <a href={href} class="inline-flex items-center text-sm px-3 py-1.5 rounded-full border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:border-blue-300 dark:hover:border-blue-600 hover:text-blue-700 dark:hover:text-blue-400 transition-colors">
          {label}
        </a>
      ))}
    </nav>

    <div class="space-y-20">

      <!-- Install -->
      <section id="install" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">Install</h2>

        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wide mb-2">From crates.io</h3>
            <CodeBlock code="cargo install kham-cli" lang="bash" label="shell" />
          </div>
          <div>
            <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wide mb-2">Pre-built binaries (no Rust toolchain required)</h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
              Download a binary for your platform from the
              <a href="https://github.com/preedep/kham/releases" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">GitHub Releases page</a>.
              Platforms: macOS arm64/x86_64, Linux x86_64, Windows x86_64.
            </p>
            <CodeBlock
              code={`# macOS / Linux — extract and move to PATH
tar xzf kham-cli-0.8.0-aarch64-apple-darwin.tar.gz
sudo mv kham /usr/local/bin/

# Verify
kham --version`}
              lang="bash"
              label="shell"
            />
          </div>
          <div>
            <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wide mb-2">Build from source</h3>
            <CodeBlock
              code={`git clone https://github.com/preedep/kham
cd kham
cargo build -p kham-cli --release
# Binary at: target/release/kham`}
              lang="bash"
              label="shell"
            />
          </div>
        </div>
      </section>

      <!-- Basic segmentation -->
      <section id="basic" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">Basic segmentation</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-4">
          Pass Thai text as an argument. Tokens are separated by <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono text-sm">|</code> by default.
        </p>
        <CodeBlock
          code={`kham "กินข้าวกับปลา"
# กิน|ข้าว|กับ|ปลา

# Mixed-script input
kham "Hello กรุงเทพ 2024"
# Hello| |กรุงเทพ| |2024

# Multiple sentences
kham "กินข้าว" "เที่ยวทะเล"
# กิน|ข้าว
# เที่ยว|ทะเล`}
          lang="bash"
          label="shell"
        />
      </section>

      <!-- Output flags -->
      <section id="output-flags" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">Output flags</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-6">Control what information is attached to each token.</p>

        <div class="space-y-6">
          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2"><code class="text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--kind</code> — token script category</h3>
            <CodeBlock
              code={`kham --kind "Hello กรุงเทพ 2024"
# Hello:Latin| :Whitespace|กรุงเทพ:Thai| :Whitespace|2024:Number`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2"><code class="text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--spans</code> — Unicode char offsets</h3>
            <CodeBlock
              code={`kham --spans "กินข้าว"
# กิน:0-3|ข้าว:3-7`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2"><code class="text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--kind --spans</code> — combined</h3>
            <CodeBlock
              code={`kham --kind --spans "กินข้าว"
# กิน:Thai:0-3|ข้าว:Thai:3-7`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2"><code class="text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--sep</code> — custom separator</h3>
            <CodeBlock
              code={`kham --sep " " "กินข้าวกับปลา"
# กิน ข้าว กับ ปลา

kham --sep $'\n' "กินข้าวกับปลา"
# กิน
# ข้าว
# กับ
# ปลา`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2"><code class="text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--whitespace</code> — include whitespace tokens</h3>
            <CodeBlock
              code={`# By default whitespace tokens are hidden
kham "กิน ข้าว"
# กิน|ข้าว

# Include them explicitly
kham --whitespace "กิน ข้าว"
# กิน| |ข้าว`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2"><code class="text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--normalize</code> — Unicode normalization before segmenting</h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
              Reorders floating vowels (สระลอย), deduplicates tone marks, and composes sara am (อำ) before segmenting.
              Use this when your input may come from multiple keyboards or encodings.
            </p>
            <CodeBlock
              code={`kham --normalize "กินข้าวกับปลา"
# กิน|ข้าว|กับ|ปลา`}
              lang="bash"
              label="shell"
            />
          </div>
        </div>
      </section>

      <!-- FTS mode -->
      <section id="fts" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">FTS mode (<code class="text-xl bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--fts</code>)</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-4">
          Switches to the <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono text-sm">FtsTokenizer</code> pipeline used by the PostgreSQL and SQLite extensions.
          Each token is printed on its own line with tab-separated metadata fields — ideal for inspecting what the search index will contain.
        </p>

        <div class="space-y-6">
          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2">Basic FTS output</h3>
            <CodeBlock
              code={`kham --fts "กินข้าวกับปลา"
# text    kind  pos         ne    stop   syn
# กิน     Thai  verb        -     false  กิน
# ข้าว    Thai  noun        -     false  ข้าว
# กับ     Thai  preposition -     true   (empty — stopword suppressed)
# ปลา     Thai  noun        -     false  ปลา`}
              lang="bash"
              label="shell"
            />
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
              Fields: <code class="font-mono">text</code> · <code class="font-mono">kind=KIND</code> · <code class="font-mono">pos=POS</code> · <code class="font-mono">ne=NE</code> · <code class="font-mono">stop=BOOL</code> · <code class="font-mono">syn=SYNONYMS</code>
            </p>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2"><code class="text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--soundex</code> — add phonetic code to <code class="text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">syn=</code></h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
              Valid algorithms: <code class="font-mono">lk82</code> (default), <code class="font-mono">udom83</code>, <code class="font-mono">metasound</code>. Only applies to Thai and Named tokens.
            </p>
            <CodeBlock
              code={`kham --fts --soundex lk82 "กินข้าวกับปลา"
# กิน    Thai  verb  -  false  กิน	1500
# ข้าว   Thai  noun  -  false  ข้าว	5800
# กับ    Thai  prep  -  true   (stopword)
# ปลา    Thai  noun  -  false  ปลา	4800`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2">Named entity inspection</h3>
            <CodeBlock
              code={`kham --fts "กรุงเทพมหานครเป็นเมืองหลวงของไทย"
# กรุงเทพมหานคร  Thai  noun  place  false  กรุงเทพมหานคร
# เป็น           Thai  verb  -      false  เป็น
# เมืองหลวง     Thai  noun  -      false  เมืองหลวง
# ของ            Thai  prep  -      true   (stopword)
# ไทย            Thai  noun  place  false  ไทย`}
              lang="bash"
              label="shell"
            />
          </div>
        </div>
      </section>

      <!-- Confidence -->
      <section id="confidence" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">Confidence scores</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-6">
          Every token carries a confidence score: <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono text-sm">0.0</code> for unknown tokens,
          <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono text-sm">1.0</code> for unambiguous dictionary matches, intermediate values reflect TNC corpus frequency and boundary ambiguity.
        </p>

        <div class="space-y-6">
          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2"><code class="text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--confidence</code> — show score per token</h3>
            <CodeBlock
              code={`kham --confidence "กินข้าวกับปลา"
# กิน:Thai:conf=0.92|ข้าว:Thai:conf=0.98|กับ:Thai:conf=1.00|ปลา:Thai:conf=0.99

kham --kind --confidence "กินข้าวกับปลา"
# กิน:Thai:conf=0.92|ข้าว:Thai:conf=0.98|กับ:Thai:conf=1.00|ปลา:Thai:conf=0.99`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2"><code class="text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--min-confidence</code> — filter low-confidence tokens</h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
              Useful for extracting only high-quality tokens from noisy input. Works in both basic and FTS mode.
            </p>
            <CodeBlock
              code={`# Only tokens with confidence ≥ 0.9
kham --min-confidence 0.9 "ข้อความที่มีคำผิดและคำถูก"
# ข้อความ|ที่มี|คำ|ถูก

# Combined with FTS mode
kham --fts --min-confidence 0.85 "กินข้าวกับปลา"`}
              lang="bash"
              label="shell"
            />
          </div>
        </div>
      </section>

      <!-- Spell checking -->
      <section id="spell" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">Spell checking (<code class="text-xl bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--spell</code>)</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-4">
          Returns ranked spelling suggestions for the input word. Candidates have edit distance ≤ 2 and are sorted by:
          phonetic similarity (lk82 soundex match), edit distance, then TNC corpus frequency.
        </p>

        <div class="space-y-6">
          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2">Basic spell check</h3>
            <CodeBlock
              code={`kham --spell "กีนข้าว"
# Suggestions for "กีนข้าว":
#   1. กินข้าว   edit=1  soundex=true
#   2. กินข้าวๆ  edit=2  soundex=true
#   3. กินข้าวร้อน  edit=3  soundex=false
# …

# A correctly spelled word returns itself at edit distance 0
kham --spell "กิน"
# Suggestions for "กิน":
#   1. กิน  edit=0  soundex=true`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2"><code class="text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--top-n</code> — limit results</h3>
            <CodeBlock
              code={`kham --spell --top-n 3 "กีนข้าว"
# Suggestions for "กีนข้าว":
#   1. กินข้าว   edit=1  soundex=true
#   2. กินข้าวๆ  edit=2  soundex=true
#   3. กินข้าวร้อน  edit=3  soundex=false`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2">Spell-check a word list via stdin</h3>
            <CodeBlock
              code={`# Each line is treated as an independent word
printf 'กีนข้าว\nกรุงเทฑ\nปลา\n' | kham --spell --top-n 1`}
              lang="bash"
              label="shell"
            />
          </div>
        </div>
      </section>

      <!-- Keyword extraction -->
      <section id="keywords" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">Keyword extraction (<code class="text-xl bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--keywords</code>)</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-4">
          Extracts the most distinctive words and phrases from the text, scored by TF × inverse-corpus-frequency.
          Stopwords and single-character tokens are excluded. Output has two sections: unigram keywords and n-gram keyphrases (bigrams / trigrams).
        </p>

        <div class="space-y-6">
          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2">Extract keywords from text</h3>
            <CodeBlock
              code={`kham --keywords "นักวิทยาศาสตร์ค้นพบดาวเคราะห์ใหม่ในระบบสุริยะ ดาวดวงนี้โคจรอยู่ใกล้ดาวเคราะห์น้อย"
# Keywords:
#   1. ดาวเคราะห์   score=0.4821  count=2
#   2. ระบบสุริยะ   score=0.3210  count=1
#   3. นักวิทยาศาสตร์  score=0.2980  count=1
#
# Keyphrases:
#   1. ดาวเคราะห์ใหม่    score=0.3100
#   2. ระบบสุริยะ ดาว    score=0.1900`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2"><code class="text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--top-n</code> — limit results per section</h3>
            <CodeBlock
              code={`kham --keywords --top-n 5 "ข้อความยาว…"`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2">Process documents via stdin</h3>
            <CodeBlock
              code={`# Each line is treated as an independent document
cat article.txt | kham --keywords --top-n 10`}
              lang="bash"
              label="shell"
            />
          </div>
        </div>
      </section>

      <!-- Romanization -->
      <section id="romanize" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">RTGS romanization (<code class="text-xl bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--romanize</code>)</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-4">
          Segments the text and transliterates every Thai/Named token to RTGS Latin. Non-Thai tokens (numbers, Latin, punctuation, whitespace) pass through unchanged.
        </p>
        <CodeBlock
          code={`kham --romanize "กินข้าวกับปลา"
# kin khao kap pla

kham --romanize "กรุงเทพมหานครเป็นเมืองหลวงของไทย"
# krung thep maha nakhon pen mueang luang khong thai

# Mixed-script: non-Thai tokens pass through
kham --romanize "Hello กรุงเทพ 2024"
# Hello krung thep 2024`}
          lang="bash"
          label="shell"
        />
      </section>

      <!-- Output formats -->
      <section id="formats" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">Output formats (<code class="text-xl bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--format</code>)</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-6">
          All modes support three output formats: <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono text-sm">text</code> (default), <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono text-sm">json</code>, and <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono text-sm">csv</code>.
        </p>

        <div class="space-y-6">
          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2">JSON output</h3>
            <CodeBlock
              code={`kham --format json "กินข้าวกับปลา"
# [{"text":"กิน","kind":"Thai","char_start":0,"char_end":3,"confidence":0.92},
#  {"text":"ข้าว","kind":"Thai","char_start":3,"char_end":7,"confidence":0.98},
#  {"text":"กับ","kind":"Thai","char_start":7,"char_end":10,"confidence":1.0},
#  {"text":"ปลา","kind":"Thai","char_start":10,"char_end":13,"confidence":0.99}]

# Pretty-print with jq
kham --format json "กินข้าว" | jq .`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2">CSV output</h3>
            <CodeBlock
              code={`kham --format csv "กินข้าวกับปลา"
# text,kind,char_start,char_end,confidence
# กิน,Thai,0,3,0.92
# ข้าว,Thai,3,7,0.98
# กับ,Thai,7,10,1.0
# ปลา,Thai,10,13,0.99`}
              lang="bash"
              label="shell"
            />
          </div>

          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2">JSON in FTS mode</h3>
            <CodeBlock
              code={`kham --fts --format json "กินข้าว"
# [{"text":"กิน","kind":"Thai","pos":"verb","ne":null,"stop":false,"syn":["กิน"],"confidence":0.92},
#  {"text":"ข้าว","kind":"Thai","pos":"noun","ne":null,"stop":false,"syn":["ข้าว"],"confidence":0.98}]`}
              lang="bash"
              label="shell"
            />
          </div>
        </div>
      </section>

      <!-- Custom dictionary -->
      <section id="custom-dict" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">Custom dictionary (<code class="text-xl bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">--dict</code>)</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-4">
          Merge domain-specific words into the built-in dictionary. The file should be plain text with one word per line.
          The custom words are overlaid on top of the built-in 62k-word dictionary — no trie rebuild required.
        </p>
        <CodeBlock
          code={`# custom_words.txt — one word per line
# (e.g., brand names, technical terms, acronyms)

kham --dict custom_words.txt "ข้อความที่มีคำเฉพาะทาง"

# Combine with other flags
kham --dict domain.txt --kind --confidence "ข้อความ"`}
          lang="bash"
          label="shell"
        />
        <div class="mt-3 p-3 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 text-sm text-amber-800 dark:text-amber-300">
          <strong>Note:</strong> <code class="font-mono">--dict</code> is incompatible with <code class="font-mono">--fts</code>. When both are given, <code class="font-mono">--dict</code> is ignored with a warning.
        </div>
      </section>

      <!-- Stdin / pipes -->
      <section id="stdin" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">Stdin and pipe usage</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-4">
          When no argument is given, kham reads from stdin — one input per line, one output per line.
        </p>
        <CodeBlock
          code={`# Pipe from echo
echo "กินข้าวกับปลา" | kham

# Process a file line by line
cat sentences.txt | kham --kind --format json

# Spell-check a word list
cat words.txt | kham --spell --top-n 1

# Extract keywords from all lines in a document
cat article.txt | kham --keywords --top-n 5

# Use with grep — keep only lines that contain ปลา after segmenting
cat corpus.txt | kham --sep $'\n' | grep 'ปลา'`}
          lang="bash"
          label="shell"
        />
      </section>

      <!-- Flag reference -->
      <section id="reference" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">Flag reference</h2>
        <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700">
          <table class="w-full text-sm">
            <thead class="bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
              <tr>
                {['Flag', 'Default', 'Description'].map(h => (
                  <th class="px-5 py-3 text-left font-semibold text-slate-700 dark:text-slate-300">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
              {[
                ['--dict &lt;FILE&gt;', '—', 'Custom word list (plain text, one word per line). Incompatible with --fts.'],
                ['--sep &lt;STR&gt;', '|', 'Token separator in text output mode.'],
                ['--whitespace', 'off', 'Include whitespace tokens in output.'],
                ['--normalize', 'off', 'Normalize text before segmenting (สระลอย, tone dedup, NFC).'],
                ['--kind', 'off', 'Append token kind: กิน:Thai.'],
                ['--spans', 'off', 'Append Unicode char span: กิน:0-3.'],
                ['--fts', 'off', 'Switch to FtsTokenizer; one token per line with tab-separated fields.'],
                ['--soundex &lt;ALGO&gt;', 'lk82', 'Phonetic code in FTS mode: lk82, udom83, metasound. Requires --fts.'],
                ['--confidence', 'off', 'Append conf=&lt;val&gt; per token in text mode.'],
                ['--min-confidence &lt;MIN&gt;', '0.0', 'Filter to tokens with confidence ≥ MIN (0.0–1.0).'],
                ['--format &lt;FMT&gt;', 'text', 'Output format: text, json, csv.'],
                ['--romanize', 'off', 'Segment and romanize Thai to RTGS Latin. Incompatible with --fts.'],
                ['--spell', 'off', 'Spell-check mode: ranked suggestions per input word.'],
                ['--keywords', 'off', 'Keyword mode: TF×IDF keywords and keyphrases.'],
                ['--top-n &lt;N&gt;', '10', 'Max results in --spell or --keywords mode.'],
              ].map(([flag, def, desc]) => (
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800">
                  <td class="px-5 py-3 font-mono text-xs text-blue-700 dark:text-blue-400 whitespace-nowrap" set:html={flag} />
                  <td class="px-5 py-3 font-mono text-xs text-slate-500 dark:text-slate-400">{def}</td>
                  <td class="px-5 py-3 text-slate-600 dark:text-slate-400 text-xs leading-relaxed" set:html={desc} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-4 p-4 rounded-lg bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 text-sm text-slate-600 dark:text-slate-400">
          <strong class="text-slate-800 dark:text-slate-200">Mode priority:</strong>
          <code class="font-mono text-xs ml-1">--spell</code> &gt; <code class="font-mono text-xs">--keywords</code> &gt; <code class="font-mono text-xs">--fts</code> &gt; basic (includes <code class="font-mono text-xs">--romanize</code>).
          Conflicting mode flags emit a warning.
        </div>
      </section>

    </div>

    <!-- Footer nav -->
    <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-700 flex justify-between text-sm">
      <a href="/getting-started" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium transition-colors">
        ← All targets
      </a>
      <a href="/demo" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium transition-colors">
        Try the live demo →
      </a>
    </div>

  </div>
</Layout>
